            branches.append(str(r['cycle']))
    lines = []
    for b in sorted(set(branches), key=natural, reverse=True):
        for ver, info in php_releases(ctx, b).items():
            if info['security'] and info['date'] and (t - info['date']).days <= 14:
                lines.append('PHP %s (%s)' % (ver, info['date']))
    if lines:
        ctx.add('info', 'news', 'php-releases', 'php.net security releases in the last 14 days: %s.' % listing(sorted(set(lines), key=natural, reverse=True), 6),
                'The php check says whether each PHP on this server already has them.')
    # 3. Ubuntu security tracker: fixes released but not installed, and serious flaws still waiting for a fix
    if is_ubuntu and codename:
        for src in sorted(s for s in sources if UBUNTU_WATCH.match(s)):
            data = ctx.fetch('Ubuntu tracker', 'https://ubuntu.com/security/cves.json?package=%s&limit=20' % urllib.parse.quote(src))
            if data is None:
                continue
            waiting = []
            for cve in data.get('cves') or []:
                prio = (cve.get('priority') or '').lower()
                for name, status, fixed in ubuntu_status(cve, codename):
                    if name != src:
                        continue
                    if status == 'released' and fixed and dpkg_lt(sources[src], fixed):
                        ctx.add('warning', 'news', 'ubuntu-%s-%s' % (cve['id'], src), '%s: Ubuntu released the fix for %s (%s priority) in %s, but %s is installed.' % (
                            src, cve['id'], prio or 'unknown', fixed, sources[src]), fix='Install the update (patches check).', ids=[cve['id']])
                    elif status in UBUNTU_OPEN and prio in ('high', 'critical') and src != 'linux':
                        ctx.add('warning', 'news', 'ubuntu-%s-%s' % (cve['id'], src), '%s: %s (%s priority) has no Ubuntu fix yet.' % (
                            src, cve['id'], prio), short(cve.get('description', ''), 200),
                            'Nothing to install yet; it installs with the next security update. Apply the upstream mitigation if there is one.', [cve['id']])
                    elif status in UBUNTU_OPEN:
                        waiting.append(cve['id'])
            if waiting:
                ctx.add('info', 'news', 'ubuntu-wait-' + src, '%s %s: %s of low or medium priority %s for an Ubuntu fix (%s).' % (
                    src, sources[src], plural(len(waiting), 'flaw'), 'waits' if len(waiting) == 1 else 'wait', listing(waiting, 4)))



def scan_php_file(path):
    text = read(path, 1024 * 1024, binary=True)
    if not text:
        return None
    low = text.lower()
    for label, hints, back, ahead, rx in SHELL_SIGNATURES:
        if near(text, low, hints, back, ahead, rx):
            return label
    if near(text, low, EXEC_WORDS, 0, 40, BLOB_EXEC) and BLOB.search(text):
        return 'hides a large encoded payload next to eval()'
    return None


def near(text, low, hints, back, ahead, rx):
    """rx.search only in the windows around each hint found in the lowercased text."""
    for h in hints:
        i = low.find(h)
        while i != -1:
            if rx.search(text, max(0, i - back), i + len(h) + ahead):
                return True
            i = low.find(h, i + len(h))
    return False


def silence_index(path):
    try:
        if os.path.getsize(path) > 200:
            return False
    except OSError:
        return False
    return 'silence' in (read(path) or '').lower() or (read(path) or '').strip() in ('<?php', '<?php //', '')


MAX_WEB_FILES = 3000000


TEST_DIRS = {'tests', 'test', 'spec', '__tests__', 'fixtures'}


def walk_web_files(ctx, max_files=MAX_WEB_FILES):
    # Follows symlinked folders (sites often live on another disk), each real folder once.
    roots, skip = scan_roots(ctx)
    seen = set(roots)
    n = 0
    for root in roots:
        for d, dirs, files in os.walk(root, followlinks=True):
            keep = []
            for x in dirs:
                if x in ('node_modules', '.git', '.svn', '.cache', '.npm'):
                    continue
                real = os.path.realpath(os.path.join(d, x))
                if real not in seen and real not in skip:
                    seen.add(real)
                    keep.append(x)
            dirs[:] = keep
            for f in files:
                n += 1
                if n > max_files:
                    ctx.walk_cut = d
                    return
                yield d, f


def check_intrusion(ctx):
    since = time.time() - ctx.conf['INTRUSION_DAYS'] * 86400
    uploads, shells, icons = [], [], []
    scanned = 0
    for d, f in walk_web_files(ctx):
        path = os.path.join(d, f)
        parts = set(p.lower() for p in d.split(os.sep))
        is_php = bool(PHP_EXT.search(f))
        if is_php and parts.intersection(UPLOAD_DIRS) and not silence_index(path) and 'vendor' not in parts:
            uploads.append(path)
        if f.lower().endswith('.ico') and '<?php' in (read(path, 2048) or ''):
            icons.append(path)
        if not is_php:
            continue
        try:
            st = os.stat(path)
        except OSError:
            continue
        if ctx.deep or max(st.st_mtime, st.st_ctime) >= since:
            scanned += 1
            why = scan_php_file(path)
            if why:
                shells.append((path, why))
    # The same file kept in several releases is one finding; a sample inside a tests folder is a warning.
    groups = {}
    for path, why in shells:
        digest = hashlib.sha1(read(path, 1024 * 1024, binary=True) or b'').hexdigest()
        groups.setdefault((why, digest), []).append(path)
    for (why, digest), paths in sorted(groups.items(), key=lambda g: g[1][0])[:30]:
        paths.sort()
        in_tests = all(set(p.lower() for p in x.split(os.sep)).intersection(TEST_DIRS) for x in paths)
        where = paths[0] if len(paths) == 1 else '%d copies of the same file (%s)' % (len(paths), listing(paths, 3))
        try:
            changed = 'Changed %s.' % datetime.datetime.fromtimestamp(os.path.getmtime(paths[0])).strftime('%Y-%m-%d %H:%M')
        except OSError:
            changed = ''
        if in_tests:
            ctx.add('warning', 'intrusion', 'shell-' + digest[:16], 'Web shell code inside a tests folder: %s %s.' % (where, why), changed,
                    'Probably a test sample. Make sure the tests folder cannot be opened from the web, then add this key to IGNORE.')
        else:
            ctx.add('critical', 'intrusion', 'shell-' + digest[:16], 'Possible web shell: %s %s.' % (where, why), changed,
                    'Open the file. If you did not write it, take the site offline, remove the file, change every password and find how it got in (outdated plugin, weak FTP or panel password).')
    if len(groups) > 30:
        ctx.add('critical', 'intrusion', 'shells-more', '%d more files look like web shells.' % (len(groups) - 30))
    if uploads:
        ctx.add('critical', 'intrusion', 'uploads-' + hashlib.sha1('\n'.join(sorted(uploads)).encode()).hexdigest()[:12],
                '%s inside upload folders: %s.' % (plural(len(uploads), 'PHP file'), listing(uploads, 5)),
                'Upload folders should only hold images and documents; PHP there is how most hacked sites get controlled.',
                'Delete the files you did not put there, and stop PHP from running in upload folders (nginx: location ~* /uploads/.*\\.php$ { deny all; }).')
    for path in icons[:10]:
        ctx.add('critical', 'intrusion', 'ico-' + path, '%s is an .ico file that contains PHP code.' % path,
                fix='This is a known trick to hide a backdoor that another file includes. Remove it and search for the file that includes it.')
    procs = ctx.procs
    users = set(ctx.web_users)
    for p in procs:
        exe, cmd = p['exe'], p['cmd']
        if p['user'] in users and re.match(r'^/(tmp|var/tmp|dev/shm)/', exe):
            ctx.add('critical', 'intrusion', 'proc-tmp-%s' % exe, 'The web user %s runs a program from a temporary folder: %s (pid %d).' % (p['user'], exe, p['pid']),
                    short(cmd, 200), 'Web servers never need this; it is almost always malware. Stop it, delete it and look for how it got in.')
        elif MINER.search(cmd) or MINER.search(os.path.basename(exe)):
            ctx.add('critical', 'intrusion', 'proc-miner-%s' % p['name'], 'A crypto-miner is running: %s (pid %d, user %s).' % (p['name'], p['pid'], p['user']), short(cmd, 200))
        elif ODD_CMD.search(cmd):
            ctx.add('critical' if p['user'] in users else 'warning', 'intrusion', 'proc-odd-%s-%s' % (p['user'], p['name']),
                    'Odd process (reverse shell or download-and-run pattern): pid %d, user %s.' % (p['pid'], p['user']), short(cmd, 200),
                    'If you did not start it, stop it and find out how it started.')
    if ctx.root:
        for tmp in ('/tmp', '/var/tmp', '/dev/shm'):
            for d, dirs, files in os.walk(tmp):
                if d.count(os.sep) - tmp.count(os.sep) >= 3:
                    dirs[:] = []
                for f in files:
                    path = os.path.join(d, f)
                    try:
                        st = os.lstat(path)
                        owner = pwd.getpwuid(st.st_uid).pw_name
                    except (OSError, KeyError):
                        continue
                    if owner not in users or not (st.st_mode & 0o111) or not os.path.isfile(path):
                        continue
                    elf = (read(path, 4, binary=True) or b'') == b'\x7fELF'
                    ctx.add('critical' if elf else 'warning', 'intrusion', 'tmp-exec-' + path,
                            'The web user %s left %s in %s: %s.' % (owner, 'a program' if elf else 'an executable script', tmp, path),
                            fix='Look at it, delete it if you do not know it, and check the sites of that user for a web shell.')
    for u in users:
        try:
            pw = pwd.getpwnam(u)
        except KeyError:
            continue
        for cron in ('/var/spool/cron/crontabs/' + u, '/var/spool/cron/' + u, '/etc/crontabs/' + u):
            text = read(cron)
            if not text:
                continue
            lines = [l for l in text.splitlines() if l.strip() and not l.strip().startswith('#') and not re.match(r'^\s*\w+=', l)]
            bad = [l for l in lines if CRON_BAD.search(l)]
            unknown = [l for l in lines if l not in bad and not CRON_OK.search(l)]
            digest = hashlib.sha1(text.encode()).hexdigest()[:12]
            if bad:
                ctx.add('critical', 'intrusion', 'cron-%s-%s' % (u, digest), 'The web user %s has suspicious scheduled tasks (%s).' % (u, cron),
                        '\n'.join(short(l, 200) for l in bad[:5]), 'Malware uses crontabs to come back after you delete it. Remove the lines you did not add: `crontab -u %s -e`.' % u)
            elif unknown:
                ctx.add('warning', 'intrusion', 'cron-%s-%s' % (u, digest), 'The web user %s has scheduled tasks (%s); check you added them.' % (u, cron),
                        '\n'.join(short(l, 200) for l in unknown[:5]), 'If they are yours, add this key to IGNORE in the config.')
        for keys in ('.ssh/authorized_keys', '.ssh/authorized_keys2'):
            path = os.path.join(pw.pw_dir, keys)
            text = read(path)
            if text and text.strip():
                n = len([l for l in text.splitlines() if l.strip() and not l.startswith('#')])
                digest = hashlib.sha1(text.encode()).hexdigest()[:12]
                prior = [k for k in ctx.seen if k.startswith('intrusion:sshkeys-%s-' % u) and not k.endswith(digest)]
                ctx.add('critical' if prior else 'warning', 'intrusion', 'sshkeys-%s-%s' % (u, digest),
                        '%s for the web user %s (%s): %s.' % ('SSH keys changed' if prior else 'SSH keys exist', u, path, plural(n, 'key')),
                        fix='Web users normally have no SSH keys. Remove keys you do not know; if they are yours, add this key to IGNORE.')
    if getattr(ctx, 'walk_cut', None):
        ctx.add('warning', 'intrusion', 'walk-cut', 'Stopped looking for web shells after %s files (at %s); the rest were not read.' % (
            '{:,}'.format(MAX_WEB_FILES), ctx.walk_cut),
            fix='Add folders that are never served (old releases, backups) to SKIP_PATHS, or point SCAN_PATHS at the live sites.')
    crashes = fpm_crashes(ctx)
    if crashes:
        ctx.add('critical' if crashes >= 20 else 'warning', 'intrusion', 'fpm-crashes', 'PHP workers crashed %s in the last 24 hours (segmentation faults).' % plural(crashes, 'time'),
                'Crashes can be a PHP or extension bug, or someone probing for a memory-corruption exploit.',
                'Look at the PHP-FPM log for the URLs at those times, and make sure PHP has every security update.')
    read_what = 'read %s %s%s' % ('{:,}'.format(scanned), 'PHP file' if scanned == 1 else 'PHP files', ' (full scan)' if ctx.deep else ' changed in the last %d days' % ctx.conf['INTRUSION_DAYS'])
    if not [f for f in ctx.findings if f.check == 'intrusion' and f.level in ATTENTION]:
        ctx.add('ok', 'intrusion', 'clean', 'No signs of intrusion (%s, upload folders, temp folders, processes, crontabs, SSH keys, crashes).' % read_what)
    else:
        ctx.add('info', 'intrusion', 'coverage', 'Web shell search: %s.' % read_what)


def fpm_crashes(ctx):
    count = 0
    cutoff = datetime.datetime.now() - datetime.timedelta(hours=24)
    for log in glob.glob('/var/log/php*fpm*.log') + glob.glob('/var/log/php-fpm/*.log') + glob.glob('/var/opt/remi/php*/log/php-fpm/*.log'):
        try:
            size = os.path.getsize(log)
            with open(log, 'rb') as f:
                f.seek(max(0, size - 2 * 1024 * 1024))
                text = f.read().decode('utf-8', 'replace')
        except OSError:
            continue
        for m in re.finditer(r'^\[(\d{2}-\w{3}-\d{4} \d{2}:\d{2}:\d{2})[^\]]*\].*exited on signal (11|7|6|4)\b', text, re.M):
            try:
                if datetime.datetime.strptime(m.group(1), '%d-%b-%Y %H:%M:%S') >= cutoff:
                    count += 1
            except ValueError:
                pass
    if which('journalctl'):
        rc, out, _ = sh(['journalctl', '-q', '--no-pager', '-o', 'cat', '-k', '--since', '-24h'], timeout=60)
        count += len(re.findall(r'(php|lsphp)[^\n]*segfault at', out or ''))
    return count


# ---------------------------------------------------------------- check: sites

HOST_RX = re.compile(r'^(?=.{1,253}$)([a-z0-9-]{1,63}\.)+[a-z]{2,63}$')


def site_hosts(ctx):
    want = ctx.conf['CHECK_URLS'].strip()
    if want == 'none':
        return []
    if want != 'auto':
        hosts = []
        for item in want.split():
            u = urllib.parse.urlparse(item if '//' in item else '//' + item)
            if u.hostname:
                hosts.append(u.hostname.lower())
        return sorted(set(hosts))
    names = set()
    if which('nginx'):
        rc, out, _ = sh([which('nginx'), '-T'], timeout=60)
        for m in re.finditer(r'^\s*server_name\s+([^;]+);', out or '', re.M):
            names.update(m.group(1).split())
    for ctl in ('apachectl', 'apache2ctl', 'httpd'):
        if which(ctl):
            rc, out, err = sh([which(ctl), '-S'], timeout=60)
            for m in re.finditer(r'(?:namevhost|alias)\s+(\S+)', (out or '') + (err or '')):
                names.add(m.group(1))
            break
    for conf in glob.glob('/etc/caddy/Caddyfile'):
        for m in re.finditer(r'^([a-z0-9.\-, ]+)\s*\{', read(conf) or '', re.M):
            names.update(x.strip() for x in m.group(1).split(','))
    out = sorted(set(n.lower().strip() for n in names if HOST_RX.match(n.lower().strip()) and not
                     re.search(r'(^|\.)(localhost|local|test|example|invalid|internal|lan)$', n.lower())))
    return out[:60]


def http_probe(host, path='/', timeout=8):
    """GET https://host/path against this server (127.0.0.1 first, then DNS). Returns dict."""
    res = {'host': host, 'path': path, 'status': None, 'error': '', 'cert_days': None, 'cert_error': '', 'body': b''}
    targets = [('127.0.0.1', 443, True), ('127.0.0.1', 80, False)]
    try:
        ip = socket.gethostbyname(host)
        targets += [(ip, 443, True), (ip, 80, False)]
    except (socket.error, UnicodeError):
        pass
    for ip, port, tls in targets:
        try:
            s = socket.create_connection((ip, port), timeout=timeout)
        except (socket.error, OSError) as e:
            res['error'] = str(e)
            continue
        try:
            if tls:
                try:
                    s2 = ssl.create_default_context().wrap_socket(s, server_hostname=host)
                    na = s2.getpeercert().get('notAfter')
                    if na:
                        res['cert_days'] = int((ssl.cert_time_to_seconds(na) - time.time()) // 86400)
                except (ssl.SSLError, ssl.CertificateError, socket.error) as e:
                    res['cert_error'] = short(e, 120)
                    s.close()
                    s = socket.create_connection((ip, port), timeout=timeout)
                    c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT) if hasattr(ssl, 'PROTOCOL_TLS_CLIENT') else ssl.SSLContext(ssl.PROTOCOL_SSLv23)
                    c.check_hostname = False
                    c.verify_mode = ssl.CERT_NONE
                    s2 = c.wrap_socket(s, server_hostname=host)
                s = s2
            s.sendall(('GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: %s\r\nAccept: */*\r\nConnection: close\r\n\r\n' % (path, host, UA)).encode())
            data = b''
            while len(data) < 65536:
                chunk = s.recv(16384)
                if not chunk:
                    break
                data += chunk
            m = re.match(rb'HTTP/\d(?:\.\d)? (\d{3})', data)
            res['status'] = int(m.group(1)) if m else None
            res['body'] = data.split(b'\r\n\r\n', 1)[1] if b'\r\n\r\n' in data else b''
            res['tls'] = tls
            res['error'] = '' if m else 'no HTTP answer'
            return res
        except (socket.error, ssl.SSLError, OSError) as e:
            res['error'] = short(e, 120)
        finally:
            try:
                s.close()
            except Exception:
                pass
    return res


def probe_sites(ctx, paths=('/',)):
    hosts = site_hosts(ctx)
    jobs = [(h, p) for h in hosts for p in paths]
    out = {}
    if not jobs:
        return out
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        for r in pool.map(lambda hp: http_probe(hp[0], hp[1]), jobs):
            out[(r['host'], r['path'])] = r
    return out


def site_ok(r):
    return r is not None and r['status'] is not None and r['status'] < 500


EXPOSURE = [
    ('/.env', 'critical', 'The .env file (database passwords, API keys) is public', lambda b: re.search(rb'^(APP_KEY|DB_PASSWORD|DB_HOST|APP_ENV|MAIL_PASSWORD|SECRET|AWS_)[A-Z_]*=', b, re.M) and not re.search(rb'<html', b[:500], re.I)),
    ('/.git/HEAD', 'critical', 'The .git folder is public (the full source code and its history can be downloaded)', lambda b: b.lstrip().startswith(b'ref: refs/')),
    ('/vendor/phpunit/phpunit/src/Util/PHP/eval-stdin.php', 'critical', 'PHPUnit eval-stdin.php is reachable (CVE-2017-9841: anyone can run code)', lambda b: len(b.strip()) < 64),
    ('/phpinfo.php', 'warning', 'A phpinfo() page is public (it shows paths, versions and settings)', lambda b: b'phpinfo()' in b or b'PHP Version' in b),
    ('/info.php', 'warning', 'A phpinfo() page is public (it shows paths, versions and settings)', lambda b: b'phpinfo()' in b or b'PHP Version' in b),
]


def check_sites(ctx):
    hosts = site_hosts(ctx)
    if not hosts:
        ctx.add('info', 'sites', 'none', 'No sites to check (set CHECK_URLS, or no nginx/apache/caddy host names found).')
        return
    now = probe_sites(ctx)
    broken = []
    for h in hosts:
        r = now.get((h, '/'))
        before = (ctx.sites_before or {}).get((h, '/'))
        if ctx.sites_before is not None and site_ok(before) and not site_ok(r):
            ctx.add('critical', 'sites', 'broke-' + h, '%s answered before tonight\'s changes and now fails (%s).' % (
                h, r['status'] or r['error']), fix='Look at the web server and PHP-FPM error logs right away.')
        elif not site_ok(r):
            broken.append('%s (%s)' % (h, r['status'] or short(r['error'], 40)))
        if r.get('cert_days') is not None and r['cert_days'] < 14:
            ctx.add('warning' if r['cert_days'] >= 0 else 'critical', 'sites', 'cert-' + h, 'The TLS certificate of %s %s.' % (
                h, 'expires in %d days' % r['cert_days'] if r['cert_days'] >= 0 else 'has expired'),
                fix='Renew it (certbot renew) and check the renewal timer.')
        elif 'expired' in r.get('cert_error', ''):
            ctx.add('warning', 'sites', 'cert-' + h, 'The TLS certificate %s serves on this server has expired.' % h,
                    'Visitors may not notice if a CDN sits in front, but the origin certificate needs renewing.', 'Renew it.')
    if broken:
        ctx.add('warning', 'sites', 'down', '%s do not answer properly: %s.' % (plural(len(broken), 'site'), listing(broken, 6)),
                fix='Check the web server and PHP-FPM logs for these hosts.')
    exposed = probe_sites(ctx, tuple(p for p, _, _, _ in EXPOSURE))
    for h in hosts:
        for path, level, title, test in EXPOSURE:
            r = exposed.get((h, path))
            if r and r['status'] == 200 and test(r['body'] or b''):
                ctx.add(level, 'sites', 'exposed-%s%s' % (h, path), '%s: https://%s%s' % (title, h, path),
                        fix='Block it in the web server (deny all for that path) and point the document root at the public folder only.')
    ok = len([h for h in hosts if site_ok(now.get((h, '/')))])
    ctx.add('ok' if ok == len(hosts) else 'info', 'sites', 'summary', '%d of %s answer%s.' % (
        ok, plural(len(hosts), 'site'), ' before and after the changes' if ctx.sites_before is not None else ''))


# ---------------------------------------------------------------- report, state and notifications

def summary(ctx):
    c = dict((l, 0) for l in LEVELS)
    for f in ctx.findings:
        c[f.level] += 1
    return c


def headline(c):
    need = c['critical'] + c['warning']
    parts = []
    if need:
        parts.append('%d need%s attention' % (need, 's' if need == 1 else ''))
    if c['fixed']:
        parts.append('%d fixed' % c['fixed'])
    if not need:
        parts.insert(0, 'all good')
    return ', '.join(parts)


def render_text(ctx, c, finished):
    host = socket.getfqdn()
    lines = ['php-security-watch %s - %s - %s' % (VERSION, host, time.strftime('%Y-%m-%d %H:%M %Z', time.localtime(finished))),
             '%s - mode %s%s' % (ctx.osr.get('PRETTY_NAME', 'Linux'), 'fix' if ctx.fix else 'report', ', full intrusion scan' if ctx.deep else ''),
             '', 'Result: %s (%d critical, %d warning, %d fixed, %d info, %d ok)' % (
                 headline(c), c['critical'], c['warning'], c['fixed'], c['info'], c['ok'])]
    sections = [('NEEDS ATTENTION', ATTENTION), ('FIXED THIS RUN', ('fixed',)), ('CHECKED', ('info', 'ok'))]
    order = [n for n, _ in CHECKS]
    for title, levels in sections:
        rows = [f for f in ctx.findings if f.level in levels]
        if not rows:
            continue
        rows.sort(key=lambda f: (RANK[f.level] if title != 'CHECKED' else 0, order.index(f.check) if f.check in order else 99))
        lines += ['', title]
        for f in rows:
            lines.append('[%s] %-9s %s%s' % (f.level, f.check, f.title, '  (new)' if f.new else ''))
            if f.detail and f.level != 'ok':
                lines += ['      ' + l for l in str(f.detail).splitlines()]
            if f.fix and f.level in ATTENTION + ('info',):
                lines.append('      Fix: ' + f.fix)
    src = ', '.join('%s %s' % (k, v) for k, v in sorted(ctx.sources.items()))
    lines += ['', 'Sources: ' + (src or 'none needed'), 'Took %d s. %s' % (finished - ctx.started, REPO)]
    return '\n'.join(lines) + '\n'


def render_json(ctx, c, finished):
    return {'tool': 'php-security-watch', 'version': VERSION, 'host': socket.getfqdn(),
            'os': ctx.osr.get('PRETTY_NAME', ''), 'mode': 'fix' if ctx.fix else 'report', 'deep_scan': ctx.deep,
            'started': utc(ctx.started), 'finished': utc(finished),
            'summary': c, 'headline': headline(c), 'sources': ctx.sources,
            'findings': [f.as_dict() for f in sorted(ctx.findings, key=lambda f: RANK[f.level])]}


def state_dir(conf):
    d = conf['STATE_DIR']
    try:
        os.makedirs(os.path.join(d, 'reports'), mode=0o700, exist_ok=True)
        if os.access(d, os.W_OK):
            return d
    except OSError:
        pass
    d = os.path.join(os.path.expanduser('~'), '.cache', 'php-security-watch')
    os.makedirs(os.path.join(d, 'reports'), mode=0o700, exist_ok=True)
    return d


def load_seen(d):
    try:
        with open(os.path.join(d, 'seen.json'), encoding='utf-8') as f:
            return json.load(f)
    except (OSError, IOError, ValueError):
        return None


def write_file(path, text, mode=0o600):
    tmp = path + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def save_reports(d, text, data):
    stamp = time.strftime('%Y%m%d-%H%M%S')
    write_file(os.path.join(d, 'reports', stamp + '.txt'), text)
    write_file(os.path.join(d, 'reports', stamp + '.json'), json.dumps(data, indent=2))
    write_file(os.path.join(d, 'last.txt'), text)
    write_file(os.path.join(d, 'last.json'), json.dumps(data, indent=2))
    files = sorted(glob.glob(os.path.join(d, 'reports', '*')))
    for old in files[:-120]:
        try:
            os.remove(old)
        except OSError:
            pass


def log_run(d, line):
    path = os.path.join(d, 'runs.log')
    lines = (read(path) or '').splitlines()[-499:] + [line]
    write_file(path, '\n'.join(lines) + '\n')


def mark_new(ctx, seen):
    now = time.time()
    keys = seen.setdefault('keys', {})
    remind = ctx.conf['REMIND_DAYS'] * 86400
    for f in ctx.findings:
        if f.level not in ATTENTION:
            continue
        s = keys.get(f.key)
        if not s or now - s.get('notified', 0) >= remind or (s.get('level') == 'warning' and f.level == 'critical'):
            f.new = True


def should_notify(ctx, seen):
    c = summary(ctx)
    attention = c['critical'] + c['warning']
    when = ctx.conf['NOTIFY_WHEN']
    if when == 'always':
        return True, 'always'
    if when == 'attention':
        return bool(attention or c['fixed']), 'attention'
    if any(f.new for f in ctx.findings) or c['fixed']:
        return True, 'new'
    wd = ctx.conf['DIGEST_WEEKDAY']
    if wd and today().isoweekday() == wd and seen.get('digest') != today().isoformat():
        return True, 'weekly digest'
    return False, ''


def update_seen(ctx, seen, notified):
    now = time.time()
    keys = seen.setdefault('keys', {})
    current = set()
    for f in ctx.findings:
        if f.level not in ATTENTION:
            continue
        current.add(f.key)
        s = keys.setdefault(f.key, {'first': now, 'notified': 0})
        s['level'], s['title'], s['last'] = f.level, f.title, now
        if notified and f.new:
            s['notified'] = now
    for k in list(keys):
        if k not in current:
            del keys[k]
    if notified:
        seen['digest'] = today().isoformat()
    return seen


def subject_line(ctx, c):
    return '[php-security-watch] %s: %s' % (socket.gethostname(), headline(c))


def send_email(conf, subject, body):
    to = [x for x in re.split(r'[,\s]+', conf['NOTIFY_EMAIL']) if x]
    sender = conf['MAIL_FROM'] or 'php-security-watch@%s' % socket.getfqdn()
    msg = EmailMessage()
    msg['Subject'], msg['From'], msg['To'] = subject, sender, ', '.join(to)
    msg['Date'] = email.utils.formatdate(localtime=True)
    msg['Message-ID'] = email.utils.make_msgid(domain=sender.split('@')[-1])
    msg.set_content(body)
    if conf['SMTP_URL']:
        u = urllib.parse.urlparse(conf['SMTP_URL'])
        port = u.port or (465 if u.scheme == 'smtps' else 587)
        user = conf['SMTP_USER'] or urllib.parse.unquote(u.username or '')
        password = conf['SMTP_PASSWORD'] or urllib.parse.unquote(u.password or '')
        if conf['SMTP_PASSWORD_FILE']:
            password = (read(conf['SMTP_PASSWORD_FILE']) or '').strip()
        tls = ssl.create_default_context()
        if u.scheme == 'smtps':
            s = smtplib.SMTP_SSL(u.hostname, port, timeout=30, context=tls)
        else:
            s = smtplib.SMTP(u.hostname, port, timeout=30)
            s.ehlo()
            if s.has_extn('starttls'):
                s.starttls(context=tls)
                s.ehlo()
        try:
            if user:
                s.login(user, password)
            s.send_message(msg)
        finally:
            try:
                s.quit()
            except Exception:
                pass
        return
    sendmail = which('sendmail') or '/usr/sbin/sendmail'
    if not os.path.exists(sendmail):
        raise RuntimeError('no SMTP_URL set and no sendmail on this server')
    rc, out, err = sh([sendmail, '-t', '-oi'], stdin=msg.as_string(), timeout=60)
    if rc != 0:
        raise RuntimeError('sendmail failed: ' + short(err or out, 200))


def webhook_format(url, fmt):
    if fmt != 'auto':
        return fmt
    host = (urllib.parse.urlparse(url).hostname or '').lower()
    if host.endswith('slack.com'):
        return 'slack'
    if 'discord' in host:
        return 'discord'
    if host == 'api.telegram.org':
        return 'telegram'
    if host.startswith('ntfy.') or '/ntfy' in url:
        return 'ntfy'
    return 'json'


def send_webhook(conf, subject, ctx, data):
    url = conf['WEBHOOK_URL']
    fmt = webhook_format(url, conf['WEBHOOK_FORMAT'])
    att = [f for f in sorted(ctx.findings, key=lambda f: RANK[f.level]) if f.level in ATTENTION + ('fixed',)]
    lines = [subject] + ['- [%s] %s%s' % (f.level, f.title, ' (new)' if f.new else '') for f in att[:15]]
    if len(att) > 15:
        lines.append('... and %d more in %s/last.txt' % (len(att) - 15, conf['STATE_DIR']))
    text = '\n'.join(lines)
    headers = {'User-Agent': UA}
    if fmt == 'slack':
        body, ctype = json.dumps({'text': text[:3500]}).encode(), 'application/json'
    elif fmt == 'discord':
        body, ctype = json.dumps({'content': text[:1900]}).encode(), 'application/json'
    elif fmt == 'telegram':
        q = urllib.parse.parse_qs(urllib.parse.urlparse(url).query)
        body = json.dumps({'chat_id': (q.get('chat_id') or [''])[0], 'text': text[:4000], 'disable_web_page_preview': True}).encode()
        ctype = 'application/json'
    elif fmt == 'ntfy':
        body, ctype = '\n'.join(lines[1:])[:3800].encode() or b'all good', 'text/plain; charset=utf-8'
        headers.update({'Title': subject.encode('ascii', 'replace').decode(), 'Tags': 'warning' if summary(ctx)['critical'] else 'shield',
                        'Priority': 'high' if summary(ctx)['critical'] else 'default'})
    else:
        body, ctype = json.dumps(data).encode(), 'application/json'
    headers['Content-Type'] = ctype
    req = urllib.request.Request(url, data=body, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as r:
        r.read()


def notify(ctx, subject, text, data):
    """Returns (channels that worked, errors)."""
    sent, errors = [], []
    if ctx.conf['NOTIFY_EMAIL']:
        try:
            send_email(ctx.conf, subject, text)
            sent.append('email')
        except Exception as e:
            errors.append('email: %s' % short(e, 200))
    if ctx.conf['WEBHOOK_URL']:
        try:
            send_webhook(ctx.conf, subject, ctx, data)
            sent.append('webhook')
        except Exception as e:
            errors.append('webhook: %s' % short(e, 200))
    return sent, errors


# ---------------------------------------------------------------- commands

RUNNERS = {'os': check_os, 'patches': check_patches, 'reboot': check_reboot, 'php': check_php, 'services': check_services,
           'runtimes': check_runtimes, 'libraries': check_libraries, 'wordpress': check_wordpress, 'news': check_news,
           'intrusion': check_intrusion, 'sites': check_sites}


def cmd_run(args, conf):
    d = state_dir(conf)
    lock = open(os.path.join(d, 'lock'), 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, IOError):
        lock.close()
        sys.stderr.write('php-security-watch: another run is in progress\n')
        return 2
    try:
        return run_locked(args, conf, d)
    finally:
        lock.close()


def run_locked(args, conf, d):
    ctx = Ctx(conf, args)
    seen = load_seen(d)
    ctx.deep = bool(args.deep) or seen is None or (conf['DIGEST_WEEKDAY'] and today().isoweekday() == conf['DIGEST_WEEKDAY'])
    seen = seen or {}
    ctx.seen = seen.get('keys', {})
    only = [x.strip() for x in (args.only or '').split(',') if x.strip()] or [n for n, _ in CHECKS]
    bad = [x for x in only if x not in RUNNERS]
    if bad:
        sys.stderr.write('php-security-watch: unknown check(s): %s (see `php-security-watch checks`)\n' % ', '.join(bad))
        return 2
    if not ctx.root:
        ctx.add('warning', 'os', 'not-root', 'Ran without root: package, process, crontab and some file checks were limited.',
                fix='Run it as root (the installed timer does).')
    if conf['_unknown']:
        ctx.add('warning', 'os', 'config-unknown', 'Unknown settings in %s: %s.' % (conf['_path'], ', '.join(conf['_unknown'])),
                fix='Check the spelling against php-security-watch.conf.example.')
    if ctx.fix and 'sites' in only:
        ctx.sites_before = probe_sites(ctx)
    for name, _ in CHECKS:
        if name not in only:
            continue
        try:
            RUNNERS[name](ctx)
        except Exception as e:  # one broken check must never hide the others
            ctx.add('warning', name, 'crashed', 'The %s check stopped with an error: %s: %s' % (name, type(e).__name__, short(e, 200)),
                    fix='Please report it at %s/issues with this line.' % REPO)
    for src, state in sorted(ctx.sources.items()):
        if state != 'ok':
            ctx.add('warning', 'news' if src in ('CISA KEV', 'Ubuntu tracker') else 'os', 'source-' + src,
                    'Could not read %s: %s. The parts that depend on it were not checked.' % (src, state),
                    fix='Check the server can reach it over HTTPS; it is retried on the next run.')
    mark_new(ctx, seen)
    finished = time.time()
    c = summary(ctx)
    data = render_json(ctx, c, finished)
    text = render_text(ctx, c, finished)
    save_reports(d, text, data)
    notified, errors, why = [], [], ''
    if not args.no_notify and (conf['NOTIFY_EMAIL'] or conf['WEBHOOK_URL']):
        go, why = should_notify(ctx, seen)
        if go:
            notified, errors = notify(ctx, subject_line(ctx, c), text, data)
    update_seen(ctx, seen, bool(notified))
    write_file(os.path.join(d, 'seen.json'), json.dumps(seen, indent=1))
    log_run(d, '%s %s critical=%d warning=%d fixed=%d deep=%s notified=%s%s took=%ds' % (
        utc(time.time()), 'fix' if ctx.fix else 'report', c['critical'], c['warning'],
        c['fixed'], 'yes' if ctx.deep else 'no', ','.join(notified) or 'no', ' errors=' + ';'.join(errors) if errors else '', finished - ctx.started))
    if args.json:
        print(json.dumps(data, indent=2))
    elif not args.quiet:
        sys.stdout.write(text)
        if notified:
            print('Notified by %s (%s).' % (' and '.join(notified), why))
    for e in errors:
        sys.stderr.write('php-security-watch: could not notify by %s\n' % e)
    if errors:
        return 2
    return 1 if c['critical'] + c['warning'] else 0


def cmd_status(args, conf):
    d = state_dir(conf)
    last = read(os.path.join(d, 'last.json'))
    print('php-security-watch %s' % VERSION)
    print('Config:   %s (mode %s, restart %s, notify %s)' % (conf['_path'], conf['MODE'], conf['RESTART_SERVICES'], ', '.join(
        x for x, on in (('email', conf['NOTIFY_EMAIL']), ('webhook', conf['WEBHOOK_URL'])) if on) or 'off'))
    print('State:    %s' % d)
    if which('systemctl') and os.path.isdir('/run/systemd/system'):
        rc, out, _ = sh(['systemctl', 'list-timers', 'php-security-watch.timer', '--no-pager', '--all'])
        line = [l for l in out.splitlines() if 'php-security-watch' in l]
        print('Timer:    %s' % (' '.join(line[0].split()[:4]) if line else 'not installed'))
    elif os.path.exists('/etc/cron.d/php-security-watch') or 'php-security-watch' in (read('/etc/crontabs/root') or ''):
        print('Schedule: cron')
    if not last:
        print('Last run: never')
        return 0
    data = json.loads(last)
    print('Last run: %s - %s' % (data['finished'], data['headline']))
    for f in data['findings']:
        if f['level'] in ATTENTION:
            print('  [%s] %s' % (f['level'], f['title']))
    print('Full report: %s' % os.path.join(d, 'last.txt'))
    return 0


def cmd_test_notify(args, conf):
    if not conf['NOTIFY_EMAIL'] and not conf['WEBHOOK_URL']:
        print('No NOTIFY_EMAIL or WEBHOOK_URL in %s.' % conf['_path'])
        return 2
    ctx = Ctx(conf, args)
    ctx.add('info', 'os', 'test', 'This is a test message from php-security-watch on %s.' % socket.getfqdn())
    c = summary(ctx)
    text = render_text(ctx, c, time.time())
    sent, errors = notify(ctx, '[php-security-watch] %s: test message' % socket.gethostname(), text, render_json(ctx, c, time.time()))
    for s in sent:
        print('OK    %s' % s)
    for e in errors:
        print('FAIL  %s' % e)
    return 0 if not errors else 2


def cmd_checks(args, conf):
    for name, desc in CHECKS:
        print('%-10s %s' % (name, desc))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog='php-security-watch', description='Nightly security watch for PHP servers. ' + REPO)
    p.add_argument('--version', action='version', version='php-security-watch ' + VERSION)
    p.add_argument('--config', default=os.environ.get('PSW_CONFIG', DEFAULT_CONFIG), help='config file (default %(default)s)')
    sub = p.add_subparsers(dest='command')
    r = sub.add_parser('run', help='run every check now')
    r.add_argument('--apply', action='store_true', help='fix mode for this run (install security updates, restart per RESTART_SERVICES)')
    r.add_argument('--no-notify', action='store_true', help='do not send email or webhook')
    r.add_argument('--json', action='store_true', help='print the report as JSON')
    r.add_argument('--quiet', action='store_true', help='print nothing (for cron and timers)')
    r.add_argument('--deep', action='store_true', help='read every PHP file, not only recently changed ones')
    r.add_argument('--only', help='comma separated checks, e.g. php,libraries')
    sub.add_parser('status', help='show the last result and the next run')
    sub.add_parser('test-notify', help='send a test email/webhook')
    sub.add_parser('checks', help='list the checks')
    args = p.parse_args(argv)
    if not args.command:
        p.print_help()
        return 0
    try:
        conf = load_config(args.config, required=False)
    except ConfigError as e:
        sys.stderr.write('php-security-watch: %s\n' % e)
        return 2
    return {'run': cmd_run, 'status': cmd_status, 'test-notify': cmd_test_notify, 'checks': cmd_checks}[args.command](args, conf)


if __name__ == '__main__':
    sys.exit(main())

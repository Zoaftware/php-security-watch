def apt_env():
    env = dict(os.environ)
    env.update({'DEBIAN_FRONTEND': 'noninteractive', 'NEEDRESTART_SUSPEND': '1', 'NEEDRESTART_MODE': 'l',
                'LC_ALL': 'C', 'APT_LISTCHANGES_FRONTEND': 'none'})
    return env


def parse_apt_simulation(text):
    """Inst lines from `apt-get -s dist-upgrade` -> (security, other) lists of (package, old, new)."""
    sec, other = [], []
    for line in text.splitlines():
        m = re.match(r'^Inst (\S+) (?:\[([^\]]*)\] )?\((\S+) (.*)\)', line)
        if not m:
            continue
        item = (m.group(1), m.group(2) or '', m.group(3))
        (sec if re.search(r'-security|Debian-Security|/updates\b', m.group(4), re.I) else other).append(item)
    return sec, other


def parse_dnf_updateinfo(text):
    """`dnf updateinfo list --security` (dnf4) or `dnf advisory list --security` (dnf5) -> [(advisory, severity, package)]."""
    out = []
    for line in text.splitlines():
        t = line.split()
        if len(t) < 3 or not re.match(r'^[A-Z][A-Z0-9]*-', t[0]):
            continue
        sev = ''
        for x in t[1:]:
            m = re.match(r'^(Critical|Important|Moderate|Low|None)', x, re.I)
            if m:
                sev = m.group(1).lower()
                break
        pkg = next((x for x in t[1:] if re.search(r'-\d.*\.(x86_64|aarch64|noarch|i686|ppc64le|s390x|src)$', x)), t[-1])
        out.append((t[0], sev, pkg))
    return out


def parse_apk_outdated(text):
    out = []
    for line in text.splitlines():
        m = re.match(r'^(\S+?)-(\d\S*-r\d+)\s+<\s+(\S+)', line.strip())
        if m:
            out.append((m.group(1), m.group(2), m.group(3)))
    return out


def parse_zypper_patches(text):
    out = []
    for line in text.splitlines():
        cols = [c.strip() for c in line.split('|')]
        if len(cols) >= 6 and cols[2].lower() == 'security' and cols[5].lower() in ('needed', 'applicable'):
            out.append((cols[1], cols[3].lower(), cols[6] if len(cols) > 6 else ''))
    return out


def pending_security_updates(ctx):
    """Returns (items, level, note) where items are human readable package names."""
    pm = ctx.pm
    if pm == 'apt':
        if ctx.conf['APT_UPDATE'] == 'yes' and ctx.root:
            rc, _, err = sh(['apt-get', 'update', '-qq', '-o', 'DPkg::Lock::Timeout=300', '-o', 'Acquire::Retries=3'],
                            timeout=600, env=apt_env())
            if rc != 0:
                ctx.add('warning', 'patches', 'apt-update', 'Could not refresh the package lists (apt-get update failed).',
                        short(err, 300), 'Run `apt-get update` by hand and fix the repository error it shows.')
        rc, out, err = sh(['apt-get', '-s', '-o', 'Debug::NoLocking=1', 'dist-upgrade'], timeout=300, env=apt_env())
        if rc != 0:
            return None, 'apt-get -s dist-upgrade failed: ' + short(err, 200)
        sec, other = parse_apt_simulation(out)
        return [(p, old, new, '') for p, old, new in sec], '%d other (non-security) updates waiting' % len(other)
    if pm in ('dnf', 'yum'):
        if pm == 'dnf':
            rc, out, err = sh(['dnf', '-q', 'updateinfo', 'list', '--security'], timeout=600)
            if rc != 0 and 'updateinfo' in err:
                rc, out, err = sh(['dnf', '-q', 'advisory', 'list', '--security'], timeout=600)
        else:
            rc, out, err = sh(['yum', '-q', 'updateinfo', 'list', 'security'], timeout=600)
        if rc not in (0, 100):
            return None, '%s updateinfo failed: %s' % (pm, short(err, 200))
        items = [(pkg, '', adv, sev) for adv, sev, pkg in parse_dnf_updateinfo(out)]
        note = ''
        if not items and ctx.os_id in ('centos',):
            note = 'CentOS Stream does not publish security advisories, so security-only updates cannot be told apart'
        return items, note
    if pm == 'apk':
        if ctx.root:
            sh(['apk', 'update', '-q'], timeout=300)
        rc, out, err = sh(['apk', 'version', '-l', '<'], timeout=300)
        if rc != 0:
            return None, 'apk version failed: ' + short(err, 200)
        return [(p, old, new, '') for p, old, new in parse_apk_outdated(out)], \
            'Alpine stable branches only ship security and bug fixes, so every pending upgrade is listed'
    if pm == 'zypper':
        rc, out, err = sh(['zypper', '-q', '--non-interactive', 'list-patches', '--category', 'security'], timeout=600)
        if rc not in (0, 100):
            return None, 'zypper list-patches failed: ' + short(err, 200)
        return [(name, '', summary, sev) for name, sev, summary in parse_zypper_patches(out)], ''
    return None, 'no supported package manager found (apt, dnf, yum, apk, zypper)'


def apply_security_updates(ctx, items):
    pm = ctx.pm
    if pm == 'apt':
        if which('unattended-upgrade'):
            rc, out, err = sh(['unattended-upgrade', '-v'], timeout=3600, env=apt_env())
        names = [p for p, _, _, _ in items]
        still, _ = pending_security_updates(ctx)
        left = [p for p, _, _, _ in (still or []) if p in names]
        if left:
            rc, out, err = sh(['apt-get', 'install', '--only-upgrade', '-y', '-q', '-o', 'DPkg::Lock::Timeout=300',
                               '-o', 'Dpkg::Options::=--force-confdef', '-o', 'Dpkg::Options::=--force-confold'] + left,
                              timeout=3600, env=apt_env())
            return rc == 0, err or out
        return True, ''
    cmd = {'dnf': ['dnf', '-y', '-q', 'upgrade', '--security'],
           'yum': ['yum', '-y', '-q', 'update', '--security'],
           'apk': ['apk', 'upgrade', '-q'],
           'zypper': ['zypper', '-n', '-q', 'patch', '--category', 'security']}.get(pm)
    if not cmd:
        return False, 'unsupported package manager'
    rc, out, err = sh(cmd, timeout=3600)
    return rc in (0, 102, 103), err or out


def auto_updates_state(ctx):
    if ctx.pm == 'apt':
        conf = ''.join(read(p) or '' for p in glob.glob('/etc/apt/apt.conf.d/*'))
        on = re.search(r'APT::Periodic::Unattended-Upgrade\s+"?(\d+)"?', conf)
        return bool(on and on.group(1) != '0' and which('unattended-upgrade')), 'unattended-upgrades'
    if ctx.pm == 'dnf' and ctx.systemd:
        for t in ('dnf-automatic-install.timer', 'dnf-automatic.timer', 'dnf5-automatic.timer'):
            if sh(['systemctl', 'is-enabled', '--quiet', t])[0] == 0:
                return True, 'dnf-automatic'
        return False, 'dnf-automatic'
    return None, ''


def check_patches(ctx):
    items, note = pending_security_updates(ctx)
    if items is None:
        ctx.add('warning', 'patches', 'unavailable', 'Could not check for security updates.', note,
                'Run the package manager by hand to see the error.')
        return
    ctx.pending_security = [i[0] for i in items]
    auto, tool = auto_updates_state(ctx)
    if items and ctx.fix:
        ok, out = apply_security_updates(ctx, items)
        after, _ = pending_security_updates(ctx)
        left = after or []
        done = [i for i in items if i[0] not in [x[0] for x in left]]
        if done:
            ctx.add('fixed', 'patches', 'applied', 'Installed %s: %s.' % (plural(len(done), 'security update'),
                    listing(i[0] for i in done)), '', '', [i[2] for i in done if i[2].startswith(('RHSA', 'ALSA', 'RLSA', 'ELSA', 'FEDORA', 'ALAS'))])
        if left:
            ctx.add('warning', 'patches', 'not-applied', '%s could not be installed: %s.' % (
                plural(len(left), 'security update'), listing(i[0] for i in left)), short(out, 400),
                'Run the upgrade by hand to see why (held package, broken dependency, full disk).')
        ctx.pending_security = [i[0] for i in left]
        items = left
    elif items:
        sev = set(i[3] for i in items)
        level = 'critical' if sev.intersection({'critical'}) else 'warning'
        ctx.add(level, 'patches', 'pending', '%s waiting to be installed: %s.' % (
            plural(len(items), 'security update'), listing(i[0] for i in items)),
            note if note and 'other' not in note else '',
            'Install them now (%s) or set MODE=fix to let this tool install them every night.' % {
                'apt': 'apt-get upgrade', 'dnf': 'dnf upgrade --security', 'yum': 'yum update --security',
                'apk': 'apk upgrade', 'zypper': 'zypper patch --category security'}.get(ctx.pm, 'your package manager'),
            [i[2] for i in items if re.match(r'^[A-Z]+-\d', i[2] or '')])
    if not items:
        ctx.add('ok', 'patches', 'none', 'No security updates waiting (%s).' % ctx.pm + (' %s.' % note if note else ''))
    if auto is False:
        ctx.add('info', 'patches', 'auto-off', 'Automatic security updates (%s) are off.' % tool,
                fix='Turn them on, or set MODE=fix so this tool installs security updates each night.')
    elif auto:
        ctx.add('ok', 'patches', 'auto-on', 'Automatic security updates are on (%s).' % tool)


# ---------------------------------------------------------------- check: reboot and stale libraries

SKIP_MAP_PREFIX = ('/memfd:', '/dev/shm/', '/tmp/', '/var/tmp/', '/run/', '/SYSV', '/drm', '/[aio]', '/dev/zero', '/proc/')
NEVER_RESTART = re.compile(r'^(dbus|systemd-|getty@|serial-getty@|user@|docker|containerd|podman|kubelet|k3s|libvirtd|'
                           r'qemu|lxd|snapd|mysql|mysqld|mariadb|postgresql|mongod|redis|elasticsearch|opensearch|'
                           r'networkmanager|networking|firewalld|ufw|nftables|iptables|wpa_supplicant|cloud-init|'
                           r'multipathd|polkit|udisks2|lvm2|iscsid|open-vm-tools|vmtoolsd|qemu-guest-agent|walinuxagent|'
                           r'google-guest-agent|amazon-ssm-agent|unattended-upgrades|packagekit|cron|crond)', re.I)
WEB_UNITS = re.compile(r'^(nginx|apache2|httpd|caddy|lshttpd|lsws|openresty|openlitespeed|php.*fpm.*|.*php-fpm.*)\.service$', re.I)
FPM_UNITS = re.compile(r'^(php.*fpm.*|.*php-fpm.*)\.service$', re.I)


def unit_of(pid):
    cg = read('/proc/%d/cgroup' % pid) or ''
    if re.search(r'docker[-/]([0-9a-f]{12})|containerd|libpod-|/kubepods', cg):
        m = re.search(r'docker[-/]([0-9a-f]{12})', cg)
        return 'container ' + (m.group(1) if m else '?')
    m = re.findall(r'/([^/\s]+\.service)', cg)
    if m:
        u = m[-1]
        return 'user session' if u.startswith('user@') else u
    if re.search(r'session-\w+\.scope', cg):
        return 'user session'
    if 'init.scope' in cg:
        return 'systemd (PID 1)'
    return None


def stale_processes(ctx):
    """pid -> list of replaced (deleted) libraries or binary still mapped by the process."""
    stale = {}
    for p in ctx.procs:
        if p['pid'] == os.getpid():
            continue
        hits = set()
        exe = p['exe']
        if exe.endswith(' (deleted)') and not exe.startswith(SKIP_MAP_PREFIX):
            hits.add(exe[:-10])
        maps = read('/proc/%d/maps' % p['pid'])
        for line in (maps or '').splitlines():
            if not line.endswith(' (deleted)'):
                continue
            path = line.split(None, 5)[-1][:-10] if len(line.split(None, 5)) == 6 else ''
            if path.startswith('/') and '.so' in path and not path.startswith(SKIP_MAP_PREFIX):
                hits.add(path)
        if hits:
            stale[p['pid']] = sorted(hits)
    return stale


def group_stale(ctx, stale):
    groups = {}
    byname = dict((p['pid'], p) for p in ctx.procs)
    for pid, libs in stale.items():
        unit = unit_of(pid) if ctx.systemd else None
        label = unit or ('process %s' % (byname.get(pid, {}).get('name') or pid))
        g = groups.setdefault(label, {'pids': [], 'libs': set()})
        g['pids'].append(pid)
        g['libs'].update(os.path.basename(x) for x in libs)
    return groups


def kernel_pending():
    running = os.uname().release
    for base in ('/lib/modules', '/usr/lib/modules'):
        try:
            kernels = [k for k in os.listdir(base) if os.path.isdir(os.path.join(base, k))]
        except OSError:
            continue
        if running in kernels:
            newest = sorted(kernels, key=natural)[-1]
            if newest != running and natural(newest) > natural(running):
                return 'running kernel %s, newer kernel %s is installed' % (running, newest)
        return None
    return None


def fpm_test_command(unit):
    rc, out, _ = sh(['systemctl', 'show', '-p', 'ExecStart', unit])
    m = re.search(r'argv\[\]=(\S+)([^;]*)', out)
    if not m:
        return None
    args = [a for a in m.group(2).split() if a not in ('--nodaemonize', '-F', '--force-stderr', '-R', '--allow-to-run-as-root')]
    return [m.group(1)] + args + ['-t']


def restart_unit(unit):
    """Config test first, then reload (PHP-FPM) or restart. Returns (ok, message)."""
    base = unit[:-8] if unit.endswith('.service') else unit
    test = None
    if FPM_UNITS.match(unit):
        test = fpm_test_command(unit)
    elif base in ('nginx', 'openresty') and which(base):
        test = [which(base), '-t']
    elif base in ('apache2', 'httpd'):
        test = [which('apachectl') or which('apache2ctl') or 'apachectl', 'configtest']
    elif base in ('ssh', 'sshd'):
        test = [which('sshd') or '/usr/sbin/sshd', '-t']
    if test:
        rc, out, err = sh(test, timeout=60)
        if rc != 0:
            return False, 'config test failed, left running as it was: %s' % short(err or out, 200)
    action = 'reload' if FPM_UNITS.match(unit) else 'restart'
    rc, out, err = sh(['systemctl', action, unit], timeout=180)
    if rc != 0 and action == 'reload':
        rc, out, err = sh(['systemctl', 'restart', unit], timeout=180)
    time.sleep(2)
    if sh(['systemctl', 'is-active', '--quiet', unit])[0] != 0:
        sh(['systemctl', 'start', unit], timeout=180)
        if sh(['systemctl', 'is-active', '--quiet', unit])[0] != 0:
            return False, 'did not come back after %s: %s' % (action, short(err, 200))
    return True, action


def check_reboot(ctx):
    reasons = []
    if os.path.exists('/var/run/reboot-required'):
        pk = (read('/var/run/reboot-required.pkgs') or '').split()
        since = datetime.datetime.fromtimestamp(os.path.getmtime('/var/run/reboot-required')).strftime('%Y-%m-%d')
        reasons.append('the system asks for it since %s%s' % (since, ' (%s)' % listing(sorted(set(pk)), 4) if pk else ''))
    for cmd in (['needs-restarting', '-r'], ['dnf', '-q', 'needs-restarting', '-r']):
        if which(cmd[0]):
            rc, out, _ = sh(cmd, timeout=120)
            if rc == 1:
                reasons.append('needs-restarting says core libraries or the kernel were updated')
            if rc in (0, 1):
                break
    k = kernel_pending()
    if k:
        reasons.append(k)
    if reasons:
        ctx.add('warning', 'reboot', 'pending', 'A reboot is needed to finish installing security updates.',
                '; '.join(reasons) + '. This tool never reboots by itself.', 'Reboot the server at a quiet hour.')
    else:
        ctx.add('ok', 'reboot', 'none', 'No reboot pending.')
    if not ctx.root:
        return
    groups = group_stale(ctx, stale_processes(ctx))
    if ctx.fix and ctx.conf['RESTART_SERVICES'] != 'none' and ctx.systemd:
        policy = ctx.conf['RESTART_SERVICES']
        for label in sorted(groups):
            if not label.endswith('.service'):
                continue
            allowed = (policy == 'php-fpm' and FPM_UNITS.match(label)) or \
                      (policy == 'web' and WEB_UNITS.match(label)) or \
                      (policy == 'all-safe' and not NEVER_RESTART.match(label))
            if not allowed:
                continue
            ok, msg = restart_unit(label)
            if ok:
                ctx.add('fixed', 'reboot', 'restart-' + label, '%s %s so it uses the patched libraries.' % (
                    'Reloaded' if msg == 'reload' else 'Restarted', label))
            else:
                ctx.add('critical' if 'did not come back' in msg else 'warning', 'reboot', 'restart-fail-' + label,
                        'Could not restart %s: %s' % (label, msg), fix='Check `systemctl status %s`.' % label)
        ctx.procs = list_processes()
        groups = group_stale(ctx, stale_processes(ctx))
    services = sorted(g for g in groups if g.endswith('.service'))
    others = sorted(g for g in groups if not g.endswith('.service'))
    if services:
        libs = sorted(set().union(*[groups[s]['libs'] for s in services]))
        ctx.add('warning', 'reboot', 'stale-services', '%s still run replaced (old, unpatched) code: %s.' % (
            plural(len(services), 'service'), listing(services, 8)),
            'Libraries: %s.' % listing(libs, 6),
            'Restart them (`systemctl restart <name>`), or set MODE=fix with RESTART_SERVICES=php-fpm, web or all-safe.')
    if others:
        ctx.add('info', 'reboot', 'stale-other', 'Also running replaced code: %s.' % listing(others, 6),
                fix='Containers need a restart; user sessions need a log out; PID 1 needs `systemctl daemon-reexec` or a reboot.')
    if not groups:
        ctx.add('ok', 'reboot', 'fresh', 'Every running service uses the current libraries.')


# ---------------------------------------------------------------- check: php

PHP_GLOBS = ['/usr/bin/php', '/usr/bin/php[0-9]*', '/usr/local/bin/php', '/usr/local/bin/php[0-9]*',
             '/usr/sbin/php-fpm*', '/usr/local/sbin/php-fpm*', '/opt/remi/php*/root/usr/bin/php',
             '/opt/remi/php*/root/usr/sbin/php-fpm', '/opt/cpanel/ea-php*/root/usr/bin/php',
             '/opt/cpanel/ea-php*/root/usr/sbin/php-fpm', '/opt/plesk/php/*/bin/php', '/opt/plesk/php/*/sbin/php-fpm',
             '/opt/alt/php*/usr/bin/php', '/usr/local/lsws/lsphp*/bin/php', '/usr/local/lsws/lsphp*/bin/lsphp',
             '/opt/php*/bin/php', '/opt/php*/sbin/php-fpm', '/usr/local/php*/bin/php', '/usr/local/php*/sbin/php-fpm',
             '/www/server/php/*/bin/php', '/www/server/php/*/sbin/php-fpm']


def owner_of(ctx, path):
    """The package that owns a file: {'pkg', 'version', 'vendor'} or None (compiled, Docker image, manual)."""
    if ctx.pm == 'apt' and which('dpkg'):
        rc, out, _ = sh(['dpkg', '-S', path])
        if rc == 0 and out.strip():
            pkg = out.split(': ')[0].split(',')[0].strip().split(':')[0]
            return {'pkg': pkg, 'version': ctx.packages.get(pkg, ''), 'vendor': ''}
    elif ctx.pm in ('dnf', 'yum', 'zypper') and which('rpm'):
        rc, out, _ = sh(['rpm', '-qf', '--qf', '%{NAME}\t%{VERSION}-%{RELEASE}\t%{VENDOR}\n', path])
        if rc == 0 and '\t' in out:
            p = out.splitlines()[0].split('\t')
            return {'pkg': p[0], 'version': p[1], 'vendor': p[2] if len(p) > 2 else ''}
    elif ctx.pm == 'apk':
        rc, out, _ = sh(['apk', 'info', '-W', path])
        m = re.search(r'is owned by (\S+?)-(\d\S*-r\d+)', out)
        if m:
            return {'pkg': m.group(1), 'version': m.group(2), 'vendor': 'Alpine'}
    return None


def classify(ctx, owner):
    """'upstream' = follows php.net/nodejs.org releases; 'vendor' = backports by a third party; 'distro' = backports."""
    distro = ctx.osr.get('NAME', 'distribution')
    if owner is None:
        return 'upstream', 'not from a package (compiled, official Docker image or copied by hand)'
    v, vendor, pkg = owner['version'].lower(), owner['vendor'].lower(), owner['pkg'].lower()
    if 'sury' in v:
        return 'upstream', '%s %s from packages.sury.org' % (owner['pkg'], owner['version'])
    if 'remi' in v or 'remi' in vendor:
        return 'upstream', '%s %s from the Remi repository' % (owner['pkg'], owner['version'])
    if 'nodesource' in v or 'nodesource' in vendor:
        return 'upstream', '%s %s from NodeSource' % (owner['pkg'], owner['version'])
    if pkg.startswith('ea-php') or 'cpanel' in vendor:
        return 'upstream', '%s %s from cPanel EasyApache' % (owner['pkg'], owner['version'])
    if 'plesk' in pkg or 'plesk' in vendor:
        return 'upstream', '%s %s from Plesk' % (owner['pkg'], owner['version'])
    if pkg.startswith('alt-php') or 'cloudlinux' in vendor:
        return 'vendor', '%s %s from CloudLinux (it backports fixes to old PHP branches)' % (owner['pkg'], owner['version'])
    if ctx.os_id in ('alpine', 'fedora', 'arch'):
        return 'upstream', '%s %s (%s ships upstream releases)' % (owner['pkg'], owner['version'], distro)
    return 'distro', '%s %s from %s (it backports security fixes into this version)' % (owner['pkg'], owner['version'], distro)


def php_releases(ctx, branch):
    data = ctx.fetch('php.net', 'https://www.php.net/releases/index.php?json&version=%s&max=100' % branch)
    out = {}
    if isinstance(data, dict):
        for ver, info in data.items():
            if isinstance(info, dict) and vkey(ver):
                d = None
                try:
                    d = datetime.datetime.strptime(info.get('date', ''), '%d %b %Y').date()
                except ValueError:
                    pass
                out[ver] = {'date': d, 'security': 'security' in (info.get('tags') or [])}
    return out


def find_php(ctx):
    seen = {}
    paths = []
    for g in PHP_GLOBS:
        paths.extend(glob.glob(g))
    if which('php'):
        paths.append(which('php'))
    for path in paths:
        base = os.path.basename(path)
        if re.search(r'config|ize|dbg|\.\w+$', base) and not re.match(r'^php\d+(\.\d+)?$', base):
            continue
        real = os.path.realpath(path)
        if real in seen or not os.access(real, os.X_OK) or os.path.isdir(real):
            continue
        fpm = 'fpm' in os.path.basename(real)
        if fpm:
            rc, out, _ = sh([real, '-v'], timeout=20)
        else:
            rc, out, _ = sh([real, '-n', '-r', 'echo PHP_VERSION;'], timeout=20)
        m = re.search(r'(\d+\.\d+\.\d+)', out or '')
        if rc != 0 or not m:
            continue
        seen[real] = {'path': real, 'version': m.group(1), 'fpm': fpm}
    installs = []
    for real, item in sorted(seen.items()):
        kind, label = classify(ctx, owner_of(ctx, real))
        item.update({'kind': kind, 'label': label, 'branch': '.'.join(item['version'].split('.')[:2])})
        installs.append(item)
    return installs


def php_ini_risks(binary):
    rc, out, _ = sh([binary, '-i'], timeout=30)
    vals = {}
    for key in ('allow_url_include', 'display_errors', 'expose_php'):
        m = re.search(r'^%s => (\S+)' % key, out or '', re.M)
        if m:
            vals[key] = m.group(1)
    return vals


def docker_ok(ctx):
    return ctx.conf['DOCKER'] != 'no' and bool(which('docker')) and ctx.root


def docker_containers(ctx):
    if not docker_ok(ctx):
        return []
    rc, out, _ = sh(['docker', 'ps', '--format', '{{.ID}}|{{.Image}}|{{.Names}}|{{.Ports}}'], timeout=30)
    rows = []
    for line in out.splitlines() if rc == 0 else []:
        p = line.split('|', 3)
        if len(p) == 4:
            rows.append({'id': p[0], 'image': p[1], 'name': p[2], 'ports': p[3]})
    return rows


DOCKER_PHP_PROBE = ('v=$(php -r "echo PHP_VERSION;" 2>/dev/null) || exit 0; p=$(readlink -f "$(command -v php)"); '
                    'o=$( (dpkg -S "$p" 2>/dev/null | cut -d: -f1; rpm -qf "$p" 2>/dev/null; apk info -W "$p" 2>/dev/null) | head -1); '
                    'echo "$v|$p|$o"')


def check_php(ctx):
    installs = find_php(ctx)
    ctx.php_installs = installs
    if installs:
        ctx.software.add('php')
    eol_rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/php.json') or []
    t = today()
    groups = {}
    for i in installs:
        groups.setdefault((i['version'], i['kind'], i['label']), []).append(i)
    for (version, kind, label), items in sorted(groups.items()):
        branch = '.'.join(version.split('.')[:2])
        where = listing(sorted(x['path'] for x in items), 4)
        php_branch_findings(ctx, 'host', version, branch, kind, label, where, eol_rows, t)
        fpm = [x for x in items if x['fpm']]
        risky = php_ini_risks(fpm[0]['path']) if fpm else {}
        if risky.get('allow_url_include', '').lower() in ('on', '1'):
            ctx.add('critical', 'php', 'ini-url-include-' + branch, 'PHP %s allows remote include (allow_url_include=On).' % branch,
                    'Any file-inclusion bug in a site becomes remote code execution.', 'Set allow_url_include = Off in php.ini and reload PHP-FPM.')
        if risky.get('display_errors', '').lower() in ('on', '1', 'stdout'):
            ctx.add('warning', 'php', 'ini-display-errors-' + branch, 'PHP-FPM %s shows errors to visitors (display_errors=On).' % branch,
                    'Error pages leak file paths, queries and sometimes passwords.', 'Set display_errors = Off and log_errors = On in the FPM php.ini.')
        if risky.get('expose_php', '').lower() in ('on', '1'):
            ctx.add('info', 'php', 'ini-expose-' + branch, 'PHP-FPM %s announces its exact version in every response (expose_php=On).' % branch,
                    fix='Set expose_php = Off so scanners cannot match your version to known flaws so easily.')
    if not installs:
        ctx.add('info', 'php', 'none', 'No PHP binary found on the host.')
    for c in docker_containers(ctx):
        rc, out, _ = sh(['docker', 'exec', c['id'], 'sh', '-c', DOCKER_PHP_PROBE], timeout=30)
        line = (out or '').strip().splitlines()
        if rc != 0 or not line or '|' not in line[-1]:
            continue
        v, path, owner = (line[-1].split('|') + ['', ''])[:3]
        if not vkey(v):
            continue
        ctx.software.add('php')
        kind = 'upstream'
        label = 'inside container %s (%s)' % (c['name'], c['image'])
        if owner and not re.search(r'sury|remi', owner, re.I) and not owner.startswith('php8') and 'alpine' not in c['image']:
            if re.search(r'php\d', owner) and not re.search(r'-r\d+$', owner):
                kind, label = 'distro', label + ', distribution package ' + owner
        php_branch_findings(ctx, 'docker-' + c['name'], v, '.'.join(v.split('.')[:2]), kind, label, path, eol_rows, t)


def php_branch_findings(ctx, scope, version, branch, kind, label, where, eol_rows, t):
    key = '%s-%s' % (scope, version)
    row = next((r for r in eol_rows if str(r.get('cycle')) == branch), None)
    eol = parse_date(row.get('eol')) if row else None
    dead = eol is True or (isinstance(eol, datetime.date) and eol < t)
    if kind == 'upstream':
        rel = php_releases(ctx, branch)
        newer = sorted([v for v in rel if vlt(version, v)], key=vkey)
        sec = [v for v in newer if rel[v]['security']]
        if dead:
            ctx.add('critical', 'php', 'eol-' + key, 'PHP %s (%s) is past end of life%s: php.net no longer fixes its security flaws.' % (
                version, label, ' since %s' % eol if isinstance(eol, datetime.date) else ''), 'Found at %s.' % where,
                'Move the sites to a supported branch (%s).' % listing(str(r['cycle']) for r in eol_rows[:3]
                                                                     if not (parse_date(r.get('eol')) is True or (isinstance(parse_date(r.get('eol')), datetime.date) and parse_date(r.get('eol')) < t))))
        if sec:
            ctx.add('critical', 'php', 'behind-' + key, 'PHP %s (%s) is missing %s: %s.' % (
                version, label, plural(len(sec), 'security release'), listing(sec, 5)),
                'Found at %s. Latest %s release: %s.' % (where, branch, newer[-1]),
                'Update PHP to %s or later and reload PHP-FPM.' % newer[-1])
        elif newer:
            ctx.add('info', 'php', 'behind-' + key, 'PHP %s (%s): bug-fix release %s is available.' % (version, label, newer[-1]),
                    'Found at %s.' % where)
        elif rel and not dead:
            ctx.add('ok', 'php', 'current-' + key, 'PHP %s (%s) is the latest %s release.' % (version, label, branch), 'Found at %s.' % where)
        elif not rel and ctx.sources.get('php.net') == 'ok':
            ctx.add('info', 'php', 'unknown-' + key, 'PHP %s (%s): php.net lists no releases for branch %s.' % (version, label, branch))
    else:
        if dead:
            ctx.add('info', 'php', 'eol-' + key, 'PHP %s (%s): php.net ended this branch%s; your vendor keeps patching it while your OS release is supported.' % (
                version, label, ' on %s' % eol if isinstance(eol, datetime.date) else ''), 'Found at %s.' % where,
                'Plan a move to a newer PHP branch; the patches check shows whether the vendor fixes are installed.')
        else:
            ctx.add('ok', 'php', 'distro-' + key, 'PHP %s (%s).' % (version, label),
                    'Found at %s. The patches and news checks show whether its fixes are installed.' % where)
    if isinstance(eol, datetime.date) and not dead and (eol - t).days <= 120:
        ctx.add('warning', 'php', 'eol-soon-' + key, 'PHP %s security support ends on %s (%d days).' % (branch, eol, (eol - t).days),
                fix='Plan the move of the sites to a newer PHP branch now.')


# ---------------------------------------------------------------- check: services (listening ports)

SENSITIVE_PORTS = {3306: 'MySQL/MariaDB', 5432: 'PostgreSQL', 6379: 'Redis', 11211: 'Memcached', 27017: 'MongoDB',
                   9200: 'Elasticsearch', 5984: 'CouchDB', 2375: 'Docker API (no TLS)', 9000: 'PHP-FPM'}
SENSITIVE_PROCS = re.compile(r'php-fpm|php-cgi|mysqld|mariadbd|postgres|redis-server|memcached|mongod|dockerd', re.I)


def public_bind(addr):
    a = addr.strip('[]')
    if a in ('*', '0.0.0.0', '::', ''):
        return 'all interfaces'
    if a.startswith('127.') or a == '::1' or a.startswith('::ffff:127.'):
        return None
    if re.match(r'^(10\.|192\.168\.|172\.(1[6-9]|2\d|3[01])\.|fd|fe80)', a):
        return 'private network %s' % a
    return 'public address %s' % a


def listeners():
    rows = []
    if which('ss'):
        rc, out, _ = sh(['ss', '-ltnpH'])
        if rc != 0:
            rc, out, _ = sh(['ss', '-ltnp'])
        for line in out.splitlines():
            t = line.split()
            if len(t) < 4 or t[0] not in ('LISTEN',):
                continue
            local = t[3]
            proc = ' '.join(t[5:])
            names = re.findall(r'\(\("([^"]+)"', proc) or re.findall(r'"([^"]+)"', proc)
            addr, _, port = local.rpartition(':')
            if port.isdigit():
                rows.append((addr.split('%')[0], int(port), names[0] if names else ''))
    elif which('netstat'):
        rc, out, _ = sh(['netstat', '-ltnp'])
        for line in out.splitlines():
            t = line.split()
            if len(t) >= 6 and t[0].startswith('tcp') and t[5] == 'LISTEN':
                addr, _, port = t[3].rpartition(':')
                name = t[6].split('/', 1)[1] if len(t) > 6 and '/' in t[6] else ''
                if port.isdigit():
                    rows.append((addr, int(port), name))
    return rows


def check_services(ctx):
    found = False
    for addr, port, name in listeners():
        where = public_bind(addr)
        if not where:
            continue
        is_fpm = bool(re.search(r'php-fpm|php-cgi|lsphp', name, re.I))
        if not (is_fpm or SENSITIVE_PROCS.search(name) or port in SENSITIVE_PORTS):
            continue
        what = 'PHP-FPM' if is_fpm else SENSITIVE_PORTS.get(port, name)
        if is_fpm or port in (9000, 2375):
            level = 'warning' if where.startswith('private') else 'critical'
            ctx.add(level, 'services', 'listen-%s-%d' % (addr, port), '%s listens on %s port %d.' % (what, where, port),
                    'Anyone who can reach this port can run PHP code or control Docker on this server.',
                    'Make it listen on 127.0.0.1 or a unix socket, or block the port in the firewall.')
        else:
            ctx.add('warning' if not where.startswith('private') else 'info', 'services', 'listen-%s-%d' % (addr, port),
                    '%s (%s) listens on %s port %d.' % (what, name or 'process', where, port),
                    'Databases and caches open to the internet are a top cause of data theft and ransom notes.',
                    'Bind it to 127.0.0.1 (or a private network) and make sure the firewall blocks the port.')
        found = True
    for c in docker_containers(ctx):
        for m in re.finditer(r'(0\.0\.0\.0|\[?::\]?):(\d+)->(\d+)/tcp', c['ports']):
            cport = int(m.group(3))
            if cport in SENSITIVE_PORTS:
                level = 'critical' if cport in (9000, 2375) else 'warning'
                ctx.add(level, 'services', 'docker-%s-%s' % (c['name'], m.group(2)),
                        'Container %s publishes %s (port %s) on every interface.' % (c['name'], SENSITIVE_PORTS[cport], m.group(2)),
                        'Docker opens published ports around ufw and firewalld rules, so the firewall does not protect it.',
                        'Publish it as 127.0.0.1:%s:%d instead, or drop the port mapping.' % (m.group(2), cport))
                found = True
    if not found:
        ctx.add('ok', 'services', 'none', 'PHP-FPM, databases and caches only listen on local or private addresses.')


# ---------------------------------------------------------------- check: runtimes (Node.js, Python)

NODE_GLOBS = ['/usr/bin/node', '/usr/local/bin/node', '/opt/*/bin/node', '/root/.nvm/versions/node/*/bin/node',
              '/home/*/.nvm/versions/node/*/bin/node', '/usr/local/n/versions/node/*/bin/node']


def check_runtimes(ctx):
    t = today()
    nodes = {}
    paths = [p for g in NODE_GLOBS for p in glob.glob(g)] + ([which('node')] if which('node') else [])
    for p in paths:
        real = os.path.realpath(p)
        if real in nodes or not os.access(real, os.X_OK):
            continue
        rc, out, _ = sh([real, '-v'], timeout=20)
        if rc == 0 and re.match(r'^v\d+\.\d+\.\d+', out.strip()):
            nodes[real] = out.strip().lstrip('v')
    if nodes:
        ctx.software.add('nodejs')
        index = ctx.fetch('nodejs.org', 'https://nodejs.org/dist/index.json') or []
        rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/nodejs.json') or []
        for path, v in sorted(nodes.items()):
            kind, label = classify(ctx, owner_of(ctx, path))
            major = v.split('.')[0]
            row = next((r for r in rows if str(r.get('cycle')) == major), None)
            eol = parse_date(row.get('eol')) if row else None
            dead = eol is True or (isinstance(eol, datetime.date) and eol < t)
            sec = sorted([r['version'].lstrip('v') for r in index if r.get('security') and r['version'].lstrip('v').split('.')[0] == major
                          and vlt(v, r['version'].lstrip('v'))], key=vkey)
            if kind == 'distro':
                ctx.add('ok' if not dead else 'info', 'runtimes', 'node-' + path, 'Node.js %s at %s (%s).' % (v, path, label))
                continue
            if dead:
                ctx.add('critical', 'runtimes', 'node-eol-' + path, 'Node.js %s at %s is past end of life%s.' % (
                    v, path, ' (%s)' % eol if isinstance(eol, datetime.date) else ''), label,
                    'Move to a supported LTS line of Node.js.')
            if sec:
                ctx.add('critical', 'runtimes', 'node-behind-' + path, 'Node.js %s at %s is missing %s: %s.' % (
                    v, path, plural(len(sec), 'security release'), listing(sec, 4)), label,
                    'Update Node.js to %s or later and restart the apps that use it.' % sec[-1])
            elif not dead and index:
                ctx.add('ok', 'runtimes', 'node-' + path, 'Node.js %s at %s has every security release of its line.' % (v, path))
    pythons = {}
    for p in glob.glob('/usr/local/bin/python3*') + glob.glob('/opt/*/bin/python3*') + glob.glob('/usr/bin/python3*'):
        real = os.path.realpath(p)
        if real in pythons or not re.search(r'python3(\.\d+)?$', real) or not os.access(real, os.X_OK):
            continue
        rc, out, err = sh([real, '-c', 'import sys;print("%d.%d.%d" % sys.version_info[:3])'], timeout=20)
        if rc == 0 and vkey(out.strip()):
            pythons[real] = out.strip()
    if pythons:
        rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/python.json') or []
        for path, v in sorted(pythons.items()):
            kind, label = classify(ctx, owner_of(ctx, path))
            row = next((r for r in rows if str(r.get('cycle')) == '.'.join(v.split('.')[:2])), None)
            eol = parse_date(row.get('eol')) if row else None
            if kind != 'distro' and (eol is True or (isinstance(eol, datetime.date) and eol < t)):
                ctx.add('warning', 'runtimes', 'python-eol-' + path, 'Python %s at %s is past end of life%s.' % (
                    v, path, ' (%s)' % eol if isinstance(eol, datetime.date) else ''), label,
                    'Install a supported Python and point your tools at it.')
    if not nodes and not pythons:
        ctx.add('info', 'runtimes', 'none', 'No Node.js or extra Python found.')


# ---------------------------------------------------------------- discovery (one walk for lock files, venvs, WordPress)

PRUNE = {'node_modules', 'vendor', '.git', '.svn', '.hg', 'cache', '.cache', '.npm', '.composer', '.yarn', 'bower_components',
         '__pycache__', '.pnpm-store', '.Trash', 'proc', 'sys'}
LOCKFILES = {'composer.lock': 'Packagist', 'package-lock.json': 'npm', 'npm-shrinkwrap.json': 'npm', 'yarn.lock': 'npm',
             'pnpm-lock.yaml': 'npm', 'Gemfile.lock': 'RubyGems', 'poetry.lock': 'PyPI', 'Pipfile.lock': 'PyPI',
             'requirements.txt': 'PyPI'}


def scan_roots(ctx):
    skip = set(os.path.realpath(p) for p in ctx.conf['SKIP_PATHS'].split())
    roots = []
    for p in ctx.conf['SCAN_PATHS'].split():
        if os.path.isdir(p) and os.path.realpath(p) not in skip:
            roots.append(os.path.realpath(p))
    return roots, skip


def discover(ctx):
    if 'discovery' in ctx.cache:
        return ctx.cache['discovery']
    roots, skip = scan_roots(ctx)
    found = {'locks': [], 'venvs': [], 'wordpress': []}
    visited = set()
    stack = [(r, 0) for r in roots]
    while stack:
        d, depth = stack.pop()
        real = os.path.realpath(d)
        if real in visited or real in skip:
            continue
        visited.add(real)
        try:
            entries = list(os.scandir(d))
        except OSError:
            continue
        names = set(e.name for e in entries)
        if 'pyvenv.cfg' in names:
            found['venvs'].append(d)
            continue
        if 'wp-includes' in names and 'wp-admin' in names and os.path.isfile(os.path.join(d, 'wp-includes', 'version.php')):
            found['wordpress'].append(d)
        for n in names:
            if n in LOCKFILES and os.path.isfile(os.path.join(d, n)):
                if n == 'requirements.txt' and 'poetry.lock' in names:
                    continue
                found['locks'].append((os.path.join(d, n), LOCKFILES[n]))
        if depth >= ctx.conf['SCAN_MAX_DEPTH']:
            continue
        deploy = 'releases' in names and 'current' in names and os.path.islink(os.path.join(d, 'current'))
        for e in entries:
            try:
                if not e.is_dir(follow_symlinks=False) or e.name in PRUNE:
                    continue
            except OSError:
                continue
            if deploy and e.name == 'releases':
                continue
            stack.append((e.path, depth + 1))
        if deploy:
            stack.append((os.path.realpath(os.path.join(d, 'current')), depth + 1))
    ctx.cache['discovery'] = found
    return found


# ---------------------------------------------------------------- lock file parsers

def parse_composer_lock(text):
    data = json.loads(text)
    out = []
    for section, dev in (('packages', False), ('packages-dev', True)):
        for p in data.get(section) or []:
            if p.get('name') and p.get('version'):
                out.append((p['name'].lower(), p['version'], dev))
    return out


def parse_package_lock(text):
    data = json.loads(text)
    out = set()
    if isinstance(data.get('packages'), dict):
        for path, p in data['packages'].items():
            if not path or p.get('link') or not p.get('version'):
                continue
            name = p.get('name') or path.rsplit('node_modules/', 1)[-1]
            out.add((name, p['version'], bool(p.get('dev'))))
    else:
        def walk(deps):
            for name, p in (deps or {}).items():
                if isinstance(p, dict) and p.get('version') and not str(p['version']).startswith(('file:', 'link:', 'git')):
                    out.add((name, p['version'], bool(p.get('dev'))))
                    walk(p.get('dependencies'))
        walk(data.get('dependencies'))
    return sorted(out)


def parse_yarn_lock(text):
    out = set()
    for m in re.finditer(r'^"?((?:@[^@/\s",]+/)?[^@\s",]+)@[^\n]*:\s*\n(?:[ \t]+[^\n]*\n)*?[ \t]+version:?\s+"?([^"\s]+)"?', text, re.M):
        out.add((m.group(1), m.group(2), False))
    return sorted(out)


def parse_pnpm_lock(text):
    out = set()
    for m in re.finditer(r"^  '?/?((?:@[^/\s']+/)?[^@/\s'(]+)[@/](\d[^(:'\s]*)'?(?:\(.*\))?:\s*$", text, re.M):
        out.add((m.group(1), m.group(2), False))
    return sorted(out)


def parse_gemfile_lock(text):
    out = set()
    for m in re.finditer(r'^    ([A-Za-z0-9_.\-]+) \(([^)]+)\)$', text, re.M):
        v = re.sub(r'-(x86|x64|aarch|arm|java|universal|mingw|darwin|mswin)\S*$', '', m.group(2))
        out.add((m.group(1), v, False))
    return sorted(out)


def parse_poetry_lock(text):
    out = set()
    for m in re.finditer(r'^\[\[package\]\]\s*\nname\s*=\s*"([^"]+)"\s*\nversion\s*=\s*"([^"]+)"', text, re.M):
        out.add((m.group(1).lower(), m.group(2), False))
    return sorted(out)


def parse_pipfile_lock(text):
    data = json.loads(text)
    out = set()
    for section, dev in (('default', False), ('develop', True)):
        for name, p in (data.get(section) or {}).items():
            v = str(p.get('version', '')).lstrip('=')
            if v:
                out.add((name.lower(), v, dev))
    return sorted(out)


def parse_requirements(text):
    out = set()
    for line in text.splitlines():
        m = re.match(r'^\s*([A-Za-z0-9_.\-]+)(?:\[[^\]]*\])?\s*==\s*([A-Za-z0-9_.+!\-]+)', line)
        if m:
            out.add((m.group(1).lower(), m.group(2), False))
    return sorted(out)


def parse_venv(path):
    out = set()
    for meta in glob.glob(os.path.join(path, 'lib', 'python3*', 'site-packages', '*.dist-info')):
        m = re.match(r'^(.+?)-(\d[^-]*)\.dist-info$', os.path.basename(meta))
        if m:
            out.add((m.group(1).lower().replace('_', '-'), m.group(2), False))
    return sorted(out)


PARSERS = {'composer.lock': parse_composer_lock, 'package-lock.json': parse_package_lock,
           'npm-shrinkwrap.json': parse_package_lock, 'yarn.lock': parse_yarn_lock, 'pnpm-lock.yaml': parse_pnpm_lock,
           'Gemfile.lock': parse_gemfile_lock, 'poetry.lock': parse_poetry_lock, 'Pipfile.lock': parse_pipfile_lock,
           'requirements.txt': parse_requirements}


# ---------------------------------------------------------------- advisory sources

def packagist_advisories(ctx, names):
    """name -> list of Packagist security advisories (the same data `composer audit` uses)."""
    out = {}
    names = sorted(set(names))
    for i in range(0, len(names), 100):
        chunk = names[i:i + 100]
        body = '&'.join('packages[]=' + urllib.parse.quote(n) for n in chunk)
        data = ctx.fetch('Packagist', 'https://packagist.org/api/security-advisories/', data=body)
        if data is None:
            return None
        adv = data.get('advisories') or {}
        if isinstance(adv, dict):
            for name, rows in adv.items():
                out.setdefault(name.lower(), []).extend(rows or [])
    return out


def osv_details(ctx, vid):
    d = ctx.fetch('OSV', 'https://api.osv.dev/v1/vulns/' + urllib.parse.quote(vid))
    if not d:
        return {'id': vid, 'aliases': [], 'summary': '', 'severity': None, 'fixed': []}
    sev = (d.get('database_specific') or {}).get('severity')
    sev = sev.lower().replace('moderate', 'medium') if isinstance(sev, str) else None
    if not sev:
        for s in d.get('severity') or []:
            if str(s.get('type', '')).startswith('CVSS_V3'):
                sev = severity_from_score(cvss3_score(s.get('score', '')))
    return {'id': vid, 'aliases': d.get('aliases') or [], 'summary': d.get('summary') or short(d.get('details', ''), 120),
            'severity': sev, 'affected': d.get('affected') or []}


def osv_fixed(details, name):
    fixed = []
    for a in details.get('affected') or []:
        if (a.get('package') or {}).get('name', '').lower() != name.lower():
            continue
        for r in a.get('ranges') or []:
            for e in r.get('events') or []:
                if e.get('fixed'):
                    fixed.append(e['fixed'])
    return sorted(set(fixed), key=lambda v: vkey(v) or ())


def osv_query(ctx, ecosystem, pkgs):
    """[(name, version, dev)] -> {(name, version): [details]}"""
    results = {}
    pkgs = list(pkgs)
    for i in range(0, len(pkgs), 500):
        chunk = pkgs[i:i + 500]
        data = ctx.fetch('OSV', 'https://api.osv.dev/v1/querybatch', data={'queries': [
            {'package': {'name': n, 'ecosystem': ecosystem}, 'version': v} for n, v, _ in chunk]})
        if data is None:
            return None
        for (n, v, _), r in zip(chunk, data.get('results') or []):
            ids = [x['id'] for x in (r or {}).get('vulns') or []]
            if ids:
                results[(n, v)] = ids
    out = {}
    budget = 300
    for key, ids in results.items():
        rows = []
        for vid in ids:
            if budget <= 0:
                rows.append({'id': vid, 'aliases': [], 'summary': '', 'severity': None, 'affected': []})
                continue
            budget -= 1
            rows.append(osv_details(ctx, vid))
        out[key] = rows
    return out


SEV_LEVEL = {'critical': 'critical', 'high': 'critical', 'medium': 'warning', 'moderate': 'warning', 'low': 'info'}


def check_libraries(ctx):
    found = discover(ctx)
    projects = []
    for path, eco in found['locks']:
        text = read(path, 30 * 1024 * 1024)
        if text is None:
            continue
        try:
            pkgs = PARSERS[os.path.basename(path)](text)
        except (ValueError, KeyError, TypeError) as e:
            ctx.add('info', 'libraries', 'parse-' + path, 'Could not read %s: %s' % (path, short(e, 80)))
            continue
        projects.append((path, eco, pkgs))
    for venv in found['venvs']:
        pkgs = parse_venv(venv)
        if pkgs:
            projects.append((venv, 'PyPI', pkgs))
    if not projects:
        ctx.add('info', 'libraries', 'none', 'No dependency lock files or Python environments found under %s.' % ctx.conf['SCAN_PATHS'])
        return
    composer_names = set(n for path, eco, pkgs in projects if eco == 'Packagist' for n, _, _ in pkgs)
    ctx.software.update(composer_names)
    advisories = packagist_advisories(ctx, composer_names) if composer_names else {}
    by_eco = {}
    for path, eco, pkgs in projects:
        if eco != 'Packagist':
            by_eco.setdefault(eco, set()).update(pkgs)
    osv = {}
    for eco, pkgs in by_eco.items():
        res = osv_query(ctx, eco, sorted(pkgs))
        if res is None:
            osv[eco] = None
        else:
            osv.update(dict(((eco,) + k, v) for k, v in res.items()))
            osv.setdefault(eco, {})
    clean = []
    for path, eco, pkgs in projects:
        where = os.path.dirname(path) if os.path.isfile(path) else path
        hits = []
        if eco == 'Packagist':
            if advisories is None:
                continue
            for name, version, dev in pkgs:
                for a in advisories.get(name, []):
                    if constraint_match(version, a.get('affectedVersions')):
                        sev = (a.get('severity') or '').lower() or None
                        hits.append({'pkg': name, 'version': version, 'dev': dev, 'id': a.get('advisoryId') or a.get('remoteId'),
                                     'cve': a.get('cve') or '', 'title': a.get('title') or '', 'severity': sev, 'fixed': '',
                                     'link': a.get('link') or ''})
        else:
            if osv.get(eco) is None and eco in osv:
                continue
            for name, version, dev in pkgs:
                for dt in osv.get((eco, name, version), []):
                    fixed = [f for f in osv_fixed(dt, name) if vlt(version, f)]
                    cve = next((x for x in dt.get('aliases', []) if x.startswith('CVE-')), '')
                    hits.append({'pkg': name, 'version': version, 'dev': dev, 'id': dt['id'], 'cve': cve,
                                 'title': dt.get('summary', ''), 'severity': dt.get('severity'),
                                 'fixed': fixed[0] if fixed else '', 'link': 'https://osv.dev/vulnerability/' + dt['id']})
        if not hits:
            clean.append(where)
            continue
        for h in hits:
            ctx.lib_advisories.setdefault(h['cve'] or h['id'], []).append(where)
        levels = [SEV_LEVEL.get(h['severity'] or '', 'warning') for h in hits]
        # Build-only packages (dev) never run for visitors: they count as a warning at most.
        levels = [l if not h['dev'] or RANK[l] >= RANK['warning'] else 'warning' for l, h in zip(levels, hits)]
        level = min(levels, key=lambda l: RANK[l])
        pk = sorted(set('%s %s%s' % (h['pkg'], h['version'], ' (dev)' if h['dev'] else '') for h in hits))
        lines = ['%s %s: %s %s%s%s' % (h['pkg'], h['version'], h['cve'] or h['id'], '(%s) ' % h['severity'] if h['severity'] else '',
                                       short(h['title'], 90), ' - fixed in %s' % h['fixed'] if h['fixed'] else '') for h in hits[:12]]
        if any(h['dev'] for h in hits):
            lines.append('(dev) = only used to build the site, never run for visitors, so it counts as a warning at most.')
        tool = {'Packagist': 'composer update <package> --with-dependencies', 'npm': 'npm audit fix (or npm update <package>)',
                'PyPI': 'pip install -U <package>', 'RubyGems': 'bundle update <package>'}[eco]
        ctx.add(level, 'libraries', where + ':' + eco, '%s: %s with known security flaws (%s): %s.' % (
            where, plural(len(pk), 'library', 'libraries'), {'Packagist': 'PHP', 'npm': 'JavaScript', 'PyPI': 'Python', 'RubyGems': 'Ruby'}[eco],
            listing(pk, 5)), '\n'.join(lines) + ('\n... and %d more' % (len(hits) - 12) if len(hits) > 12 else ''),
            'In %s run `%s`, test the site, deploy. This tool never changes application code.' % (where, tool),
            sorted(set(h['cve'] or h['id'] for h in hits)))
    if clean:
        ctx.add('ok', 'libraries', 'clean', '%s with no known flaws: %s.' % (plural(len(clean), 'project'), listing(clean, 6)))



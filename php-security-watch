# ---------------------------------------------------------------- helpers

def sh(cmd, timeout=180, env=None, stdin=None):
    """Run a command. Returns (exit code, stdout, stderr); never raises."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout,
                           env=env, input=stdin, encoding='utf-8', errors='replace')
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'timed out after %ss' % timeout
    except OSError as e:
        return 127, '', str(e)


def which(name):
    return shutil.which(name, path=os.environ.get('PATH', '') + ':/usr/sbin:/sbin:/usr/local/sbin')


def read(path, limit=None, binary=False):
    try:
        with open(path, 'rb') as f:
            data = f.read(limit) if limit else f.read()
    except (OSError, IOError):
        return None
    return data if binary else data.decode('utf-8', 'replace')


def plural(n, one, many=None):
    return '%d %s' % (n, one if n == 1 else (many or one + 's'))


def short(text, n=160):
    text = ' '.join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + '…'


def listing(items, n=6):
    items = list(items)
    return ', '.join(items[:n]) + (' and %d more' % (len(items) - n) if len(items) > n else '')


def today():
    return datetime.date.today()


def utc(ts):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(ts))


def parse_date(value):
    """endoflife.date values are a date string, True or False."""
    if isinstance(value, bool) or value is None:
        return value
    try:
        return datetime.datetime.strptime(str(value)[:10], '%Y-%m-%d').date()
    except ValueError:
        return None


PRE = {'dev': -4, 'alpha': -3, 'a': -3, 'beta': -2, 'b': -2, 'rc': -1, 'pl': 1, 'p': 1, 'patch': 1}


def vkey(v):
    """Comparable key for versions like 8.3.12, v5.7.8, 2.0.0-beta1, 1.2.3-p1. None if not a version."""
    v = str(v).strip().lower()
    v = re.sub(r'^v(?=\d)', '', v).split('+')[0]
    m = re.match(r'^(\d+(?:\.\d+)*)(.*)$', v)
    if not m:
        return None
    nums = [int(x) for x in m.group(1).split('.')][:6]
    nums += [0] * (6 - len(nums))
    rank, n = 0, 0
    rest = m.group(2).lstrip('-._')
    m2 = re.match(r'^(dev|alpha|beta|rc|patch|pl|a|b|p)\.?(\d*)', rest) if rest else None
    if m2:
        rank, n = PRE[m2.group(1)], int(m2.group(2) or 0)
    return tuple(nums) + (rank, n)


def vlt(a, b):
    ka, kb = vkey(a), vkey(b)
    return ka is not None and kb is not None and ka < kb


def natural(s):
    return [int(x) if x.isdigit() else x for x in re.split(r'(\d+)', s)]


def constraint_match(version, constraint):
    """Composer style constraints as used by Packagist advisories: '>=2.0.0,<2.10.2|<1.5.1'."""
    v = vkey(version)
    if v is None or not constraint:
        return False
    for alt in re.split(r'\s*\|\|?\s*', str(constraint).strip()):
        alt = re.sub(r'(>=|<=|!=|==|>|<|=)\s+', r'\1', alt.strip())
        parts = [p for p in re.split(r'\s*,\s*|\s+', alt) if p]
        if not parts:
            continue
        ok = True
        for p in parts:
            m = re.match(r'^(>=|<=|!=|==|>|<|=)?v?(.+)$', p)
            op, ver = (m.group(1) or '=='), m.group(2)
            if ver == '*':
                continue
            if ver.endswith('.*'):
                prefix = ver[:-2]
                hit = vkey(version) is not None and (re.sub(r'^v', '', str(version)) + '.').startswith(prefix + '.')
                if (op in ('==', '=') and not hit) or (op == '!=' and hit):
                    ok = False
                    break
                continue
            k = vkey(ver)
            if k is None:
                ok = False
                break
            c = (v > k) - (v < k)
            if not {'>=': c >= 0, '<=': c <= 0, '>': c > 0, '<': c < 0, '==': c == 0, '=': c == 0, '!=': c != 0}[op]:
                ok = False
                break
        if ok:
            return True
    return False


def cvss3_score(vector):
    """CVSS v3.x base score from a vector string, or None."""
    try:
        m = dict(x.split(':', 1) for x in vector.split('/')[1:])
        scope = m['S']
        av = {'N': 0.85, 'A': 0.62, 'L': 0.55, 'P': 0.2}[m['AV']]
        ac = {'L': 0.77, 'H': 0.44}[m['AC']]
        pr = {'N': 0.85, 'L': 0.62 if scope == 'U' else 0.68, 'H': 0.27 if scope == 'U' else 0.5}[m['PR']]
        ui = {'N': 0.85, 'R': 0.62}[m['UI']]
        cia = {'H': 0.56, 'L': 0.22, 'N': 0.0}
        iss = 1 - (1 - cia[m['C']]) * (1 - cia[m['I']]) * (1 - cia[m['A']])
    except (KeyError, ValueError, AttributeError):
        return None
    impact = 6.42 * iss if scope == 'U' else 7.52 * (iss - 0.029) - 3.25 * (iss - 0.02) ** 15
    if impact <= 0:
        return 0.0
    expl = 8.22 * av * ac * pr * ui
    base = min(impact + expl, 10) if scope == 'U' else min(1.08 * (impact + expl), 10)
    i = int(round(base * 100000))
    return i / 100000.0 if i % 10000 == 0 else (math.floor(i / 10000) + 1) / 10.0


def severity_from_score(score):
    if score is None:
        return None
    return 'critical' if score >= 9 else 'high' if score >= 7 else 'medium' if score >= 4 else 'low'


# ---------------------------------------------------------------- config

def load_config(path, required=False):
    conf = dict(DEFAULTS)
    unknown = []
    if path and os.path.exists(path):
        with open(path, encoding='utf-8') as f:
            for n, line in enumerate(f, 1):
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                if '=' not in line:
                    raise ConfigError('%s line %d: expected KEY=VALUE' % (path, n))
                k, v = line.split('=', 1)
                k, v = k.strip().upper(), v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in '"\'':
                    v = v[1:-1]
                if k not in DEFAULTS:
                    unknown.append(k)
                conf[k] = v
    elif required:
        raise ConfigError('config file %s not found' % path)
    for k in DEFAULTS:
        if 'PSW_' + k in os.environ:
            conf[k] = os.environ['PSW_' + k]
    checks = {
        'MODE': ('report', 'fix'),
        'RESTART_SERVICES': ('none', 'php-fpm', 'web', 'all-safe'),
        'NOTIFY_WHEN': ('new', 'attention', 'always'),
        'WEBHOOK_FORMAT': ('auto', 'slack', 'discord', 'ntfy', 'telegram', 'json'),
        'DOCKER': ('auto', 'no'),
        'APT_UPDATE': ('yes', 'no'),
    }
    for k, allowed in checks.items():
        conf[k] = conf[k].strip().lower()
        if conf[k] not in allowed:
            raise ConfigError('%s=%s is not valid; use one of: %s' % (k, conf[k], ', '.join(allowed)))
    for k in ('SCAN_MAX_DEPTH', 'INTRUSION_DAYS', 'KEV_DAYS', 'DIGEST_WEEKDAY', 'REMIND_DAYS', 'TIMEOUT'):
        try:
            conf[k] = int(conf[k])
        except ValueError:
            raise ConfigError('%s must be a number, got %r' % (k, conf[k]))
    conf['_unknown'] = unknown
    conf['_path'] = path
    return conf


# ---------------------------------------------------------------- findings and context

class Finding(object):
    def __init__(self, level, check, key, title, detail='', fix='', ids=()):
        self.level, self.check, self.key = level, check, key
        self.title, self.detail, self.fix = title, detail, fix
        self.ids = list(ids)
        self.new = False

    def as_dict(self):
        return {'level': self.level, 'check': self.check, 'key': self.key, 'title': self.title,
                'detail': self.detail, 'fix': self.fix, 'ids': self.ids, 'new': self.new}


class Ctx(object):
    def __init__(self, conf, args):
        self.conf = conf
        self.args = args
        self.fix = conf['MODE'] == 'fix' or bool(getattr(args, 'apply', False))
        self.timeout = conf['TIMEOUT']
        self.findings = []
        self.sources = {}
        self.source_counts = {}  # source -> [ok, failed, last error]
        self.source_lock = threading.Lock()
        self.cache = {}
        self.root = os.geteuid() == 0
        self.osr = os_release()
        self.os_id = self.osr.get('ID', '').lower()
        self.os_like = (self.osr.get('ID_LIKE', '') + ' ' + self.os_id).lower().split()
        self.pm = detect_pm()
        self.systemd = os.path.isdir('/run/systemd/system') and bool(which('systemctl'))
        self.procs = list_processes()
        self.web_users = detect_web_users(conf, self.procs)
        self.packages = installed_packages(self.pm)
        self.software = set(self.packages)
        self.pending_security = []
        self.php_installs = []
        self.lib_advisories = {}
        self.wordpress_roots = []
        self.sites_before = None
        self.deep = False
        self.seen = {}
        self.started = time.time()
        self.ignore = set(conf['IGNORE'].split())

    def add(self, level, check, key, title, detail='', fix='', ids=()):
        f = Finding(level, check, check + ':' + key, title, detail, fix, ids)
        if self.ignore and (f.key in self.ignore or self.ignore.intersection(f.ids)) and level in ATTENTION:
            f.level, f.title = 'info', '(ignored by config) ' + title
        self.findings.append(f)
        return f

    def fetch(self, source, url, data=None, headers=None, raw=False, timeout=None):
        """HTTP GET/POST with a per-run cache. Records the source as ok or unavailable; returns None on failure."""
        key = (url, json.dumps(data, sort_keys=True) if isinstance(data, (dict, list)) else data)
        if key in self.cache:
            return self.cache[key]
        h = {'User-Agent': UA, 'Accept': 'application/json, */*'}
        body = None
        if isinstance(data, (dict, list)):
            body = json.dumps(data).encode()
            h['Content-Type'] = 'application/json'
        elif isinstance(data, str):
            body = data.encode()
            h['Content-Type'] = 'application/x-www-form-urlencoded'
        if headers:
            h.update(headers)
        out, err = None, None
        for wait in (0, 3, 10):  # busy or briefly unreachable sources get two more tries
            time.sleep(wait)
            try:
                req = urllib.request.Request(url, data=body, headers=h)
                with urllib.request.urlopen(req, timeout=timeout or self.timeout) as r:
                    payload = r.read()
                out = payload if raw else json.loads(payload.decode('utf-8', 'replace'))
                err = None
                break
            except urllib.error.HTTPError as e:
                err = e
                if e.code != 429 and e.code < 500:
                    break
            except (urllib.error.URLError, socket.timeout, ConnectionError) as e:
                err = e
            except Exception as e:  # bad JSON: retrying will not help
                err = e
                break
        self.count_source(source, err)
        self.cache[key] = out
        return out

    def count_source(self, source, err):
        """A source is "ok" only when every request to it worked; partial failures are reported."""
        with self.source_lock:
            c = self.source_counts.setdefault(source, [0, 0, ''])
            if err is None:
                c[0] += 1
            else:
                c[1] += 1
                c[2] = short(err, 90)
            if not c[1]:
                self.sources[source] = 'ok'
            elif not c[0]:
                self.sources[source] = 'unavailable (%s)' % c[2]
            else:
                self.sources[source] = 'partly unavailable (%d of %d requests failed, last: %s)' % (c[1], c[0] + c[1], c[2])


def os_release():
    out = {}
    for line in (read('/etc/os-release') or read('/usr/lib/os-release') or '').splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            out[k.strip()] = v.strip().strip('"\'')
    return out


def detect_pm():
    for name, binary in (('apt', 'apt-get'), ('dnf', 'dnf'), ('yum', 'yum'), ('apk', 'apk'), ('zypper', 'zypper')):
        if which(binary):
            return name
    return None


def installed_packages(pm):
    pkgs = {}
    if pm == 'apt':
        rc, out, _ = sh(['dpkg-query', '-W', '-f=${db:Status-Abbrev}\t${Package}\t${Version}\n'])
        for line in out.splitlines():
            p = line.split('\t')
            if len(p) == 3 and p[0].startswith('ii'):
                pkgs[p[1]] = p[2]
    elif pm in ('dnf', 'yum', 'zypper'):
        rc, out, _ = sh(['rpm', '-qa', '--qf', '%{NAME}\t%{VERSION}-%{RELEASE}\n'])
        for line in out.splitlines():
            p = line.split('\t')
            if len(p) == 2:
                pkgs[p[0]] = p[1]
    elif pm == 'apk':
        rc, out, _ = sh(['apk', 'info', '-v'])
        for line in out.splitlines():
            m = re.match(r'^(.+)-(\d[^-]*-r\d+)$', line.strip())
            if m:
                pkgs[m.group(1)] = m.group(2)
    return pkgs


def list_processes():
    procs = []
    for d in glob.glob('/proc/[0-9]*'):
        pid = int(d.rsplit('/', 1)[1])
        status = read(d + '/status') or ''
        m = re.search(r'^Uid:\s+(\d+)', status, re.M)
        n = re.search(r'^Name:\s+(.*)$', status, re.M)
        if not m:
            continue
        uid = int(m.group(1))
        try:
            user = pwd.getpwuid(uid).pw_name
        except KeyError:
            user = str(uid)
        cmd = (read(d + '/cmdline', 4096) or '').replace('\0', ' ').strip()
        try:
            exe = os.readlink(d + '/exe')
        except OSError:
            exe = ''
        procs.append({'pid': pid, 'uid': uid, 'user': user, 'name': n.group(1) if n else '', 'cmd': cmd, 'exe': exe})
    return procs


WEB_PROC = re.compile(r'^(php-fpm|php-cgi|php\d|lsphp|litespeed|lshttpd|nginx|apache2?|httpd|caddy|frankenphp|openresty)', re.I)


def detect_web_users(conf, procs):
    users = set()
    if conf['WEB_USERS'] != 'auto':
        users.update(conf['WEB_USERS'].split())
    else:
        for p in procs:
            if p['uid'] != 0 and WEB_PROC.match(p['name'] or ''):
                users.add(p['user'])
        if not users:
            for u in ('www-data', 'nginx', 'apache', 'http', 'www'):
                try:
                    pwd.getpwnam(u)
                    users.add(u)
                except KeyError:
                    pass
    users.discard('root')
    return sorted(users)


def has_software(ctx, name):
    name = name.lower()
    for s in ctx.software:
        s = s.lower()
        if s == name or s.startswith(name + '-') or s.startswith(name + '/') or re.match(re.escape(name) + r'\d', s):
            return True
    return False


# ---------------------------------------------------------------- check: os

EOL_PRODUCTS = {'ubuntu': 'ubuntu', 'debian': 'debian', 'rhel': 'rhel', 'almalinux': 'almalinux', 'rocky': 'rocky-linux',
                'alpine': 'alpine-linux', 'centos': 'centos', 'fedora': 'fedora', 'amzn': 'amazon-linux',
                'opensuse-leap': 'opensuse', 'sles': 'sles', 'ol': 'oracle-linux'}


def pick_cycle(rows, version):
    if not rows or not version:
        return None
    parts = version.split('.')
    for cand in (version, '.'.join(parts[:2]), parts[0]):
        for r in rows:
            if str(r.get('cycle')) == cand:
                return r
    return None


def check_os(ctx):
    name = ctx.osr.get('PRETTY_NAME') or 'unknown Linux'
    product = EOL_PRODUCTS.get(ctx.os_id)
    if ctx.os_id == 'centos' and 'stream' in name.lower():
        product = 'centos-stream'
    if not product:
        ctx.add('info', 'os', 'unknown', '%s: not in the end-of-life database, so its support dates were not checked.' % name)
        return
    rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/%s.json' % product)
    row = pick_cycle(rows, ctx.osr.get('VERSION_ID', ''))
    if rows is None:
        return
    if not row:
        ctx.add('info', 'os', 'nocycle', '%s: release not found in endoflife.date (%s).' % (name, product))
        return
    eol, ext = parse_date(row.get('eol')), parse_date(row.get('extendedSupport'))
    t = today()
    if eol is True or (isinstance(eol, datetime.date) and eol < t):
        if isinstance(ext, datetime.date) and ext >= t:
            ctx.add('warning', 'os', 'standard-eol', '%s: standard security support ended%s.' % (
                name, ' on %s' % eol if isinstance(eol, datetime.date) else ''),
                'Only extended support (for example Ubuntu Pro / ESM or a paid vendor plan) keeps getting fixes, until %s.' % ext,
                'Enable the extended support your vendor offers, or move the sites to a supported release.')
        else:
            ctx.add('critical', 'os', 'eol', '%s no longer gets security updates%s.' % (
                name, ' (support ended %s)' % eol if isinstance(eol, datetime.date) else ''),
                'New flaws in the kernel, OpenSSL, PHP packages and everything else on this server stay open forever.',
                'Upgrade to a supported release of your distribution or move to a new server.')
    elif isinstance(eol, datetime.date) and (eol - t).days <= 90:
        ctx.add('warning', 'os', 'eol-soon', '%s stops getting security updates on %s (%d days).' % (name, eol, (eol - t).days),
                fix='Plan the upgrade to the next supported release now.')
    else:
        ctx.add('ok', 'os', 'supported', '%s gets security updates%s.' % (
            name, ' until %s' % eol if isinstance(eol, datetime.date) else ''))



def dpkg_lt(a, b):
    return sh(['dpkg', '--compare-versions', a, 'lt', b])[0] == 0


def ubuntu_sources():
    rc, out, _ = sh(['dpkg-query', '-W', '-f=${db:Status-Abbrev}|${source:Package}|${source:Version}\n'])
    src = {}
    for line in out.splitlines():
        p = line.split('|')
        if len(p) == 3 and p[0].startswith('ii') and p[2]:
            if p[1] not in src or dpkg_lt(p[2], src[p[1]]):
                src[p[1]] = p[2]
    rc, out, _ = sh(['dpkg-query', '-W', '-f=${source:Version}', 'linux-modules-' + os.uname().release])
    if rc == 0 and out.strip():
        src['linux'] = out.strip()
    return src


def ubuntu_status(cve, codename):
    rows = []
    for p in cve.get('packages') or []:
        for s in p.get('statuses') or []:
            if s.get('release_codename') == codename:
                rows.append((p.get('name'), s.get('status'), s.get('description') or ''))
    return rows


def check_news(ctx):
    t = today()
    is_ubuntu = ctx.os_id == 'ubuntu' and which('dpkg')
    codename = ctx.osr.get('VERSION_CODENAME', '')
    sources = ubuntu_sources() if is_ubuntu else {}
    # 1. CISA Known Exploited Vulnerabilities
    kev = ctx.fetch('CISA KEV', 'https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json', timeout=90) \
        or ctx.fetch('CISA KEV', 'https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json', timeout=90)
    if kev:
        since = (t - datetime.timedelta(days=ctx.conf['KEV_DAYS'])).isoformat()
        recent = [v for v in kev.get('vulnerabilities') or [] if (v.get('dateAdded') or '') >= since]
        extra = [k.lower() for k in ctx.conf['KEV_EXTRA_KEYWORDS'].split()]
        ours = []
        for v in recent:
            text = ('%s %s' % (v.get('vendorProject', ''), v.get('product', ''))).lower()
            hit = any(re.search(rx, text) and any(has_software(ctx, n) for n in names) for rx, names in KEV_MAP)
            if hit or any(k in text for k in extra):
                ours.append(v)
        ctx.add('info', 'news', 'kev-summary', 'CISA added %s that attackers are already using in the last %d days; %d %s about software found here.' % (
            plural(len(recent), 'flaw'), ctx.conf['KEV_DAYS'], len(ours), 'is' if len(ours) == 1 else 'are'))
        for v in ours:
            cid = v.get('cveID', '')
            product = ('%s %s' % (v.get('vendorProject', ''), v.get('product', ''))).strip()
            desc = short(v.get('shortDescription', ''), 220)
            title = '%s (%s) is being exploited (CISA list since %s)' % (cid, product, v.get('dateAdded'))
            if cid in ctx.lib_advisories:
                ctx.add('critical', 'news', 'kev-' + cid, title + ' and it affects %s.' % listing(ctx.lib_advisories[cid], 3), desc,
                        'Update that library now; see the libraries section.', [cid])
                continue
            if is_ubuntu:
                detail = ctx.fetch('Ubuntu tracker', 'https://ubuntu.com/security/cves/%s.json' % cid)
                rows = ubuntu_status(detail or {}, codename)
                hit, patched = [], []
                for name, status, fixed in rows:
                    if name not in sources:
                        continue
                    if status == 'released' and fixed and not dpkg_lt(sources[name], fixed):
                        patched.append(name)
                    elif status == 'released' or status in UBUNTU_OPEN:
                        hit.append('%s %s%s' % (name, sources[name], ' (fix: %s)' % fixed if fixed else ' (no Ubuntu fix yet)'))
                if hit:
                    ctx.add('critical', 'news', 'kev-' + cid, title + ' and it affects: %s.' % listing(hit, 4), desc,
                            'Install the fix as soon as Ubuntu ships it (patches check), and apply the vendor mitigation meanwhile.', [cid])
                elif patched:
                    ctx.add('ok', 'news', 'kev-' + cid, title + '; already patched here (%s).' % listing(patched, 4), ids=[cid])
                elif detail is not None:
                    ctx.add('info', 'news', 'kev-' + cid, title + '; Ubuntu says no installed package is affected.', ids=[cid])
                else:
                    ctx.add('warning', 'news', 'kev-' + cid, title + '.', desc, 'Check that your version is patched.', [cid])
                continue
            if ctx.pm in ('dnf', 'yum'):
                rc, out, _ = sh([ctx.pm, '-q', 'updateinfo', 'list', '--cve', cid], timeout=300)
                if rc == 0 and out.strip():
                    ctx.add('critical', 'news', 'kev-' + cid, title + ' and a fix is waiting to be installed.', desc,
                            'Run `%s upgrade --cve %s` now.' % (ctx.pm, cid), [cid])
                    continue
            ctx.add('warning', 'news', 'kev-' + cid, title + '.', desc,
                    'Check that the version you run is patched (%s).' % short(v.get('requiredAction', ''), 120), [cid])
    # 2. php.net security releases in the last 14 days
    branches = sorted(set([i['branch'] for i in ctx.php_installs])) or []
    rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/php.json') or []
    for r in rows[:4]:
        e = parse_date(r.get('eol'))

def wp_plugins(root):
    out = []
    base = os.path.join(root, 'wp-content', 'plugins')
    try:
        slugs = sorted(os.listdir(base))
    except OSError:
        return out
    for slug in slugs:
        d = os.path.join(base, slug)
        if not os.path.isdir(d) or slug.startswith('.'):
            continue
        version = None
        cands = [os.path.join(d, slug + '.php')] + sorted(glob.glob(os.path.join(d, '*.php')))
        for f in cands:
            head = read(f, 8192) or ''
            if re.search(r'^\s*\*?\s*Plugin Name:', head, re.M | re.I):
                m = re.search(r'^\s*\*?\s*Version:\s*([^\s*]+)', head, re.M | re.I)
                version = m.group(1) if m else ''
                break
        if version is not None:
            out.append((slug, version))
    return out


def md5_file(path):
    h = hashlib.md5()
    try:
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(1 << 20), b''):
                h.update(chunk)
    except (OSError, IOError):
        return None
    return h.hexdigest()


def check_wordpress(ctx):
    roots = discover(ctx)['wordpress']
    ctx.wordpress_roots = roots
    if not roots:
        ctx.add('info', 'wordpress', 'none', 'No WordPress found under %s.' % ctx.conf['SCAN_PATHS'])
        return
    ctx.software.add('wordpress')
    rows = ctx.fetch('endoflife.date', 'https://endoflife.date/api/wordpress.json') or []
    t = today()
    plugin_budget = 250
    for root in roots:
        vtext = read(os.path.join(root, 'wp-includes', 'version.php')) or ''
        m = re.search(r"\$wp_version\s*=\s*'([^']+)'", vtext)
        if not m:
            continue
        version = m.group(1)
        loc = re.search(r"\$wp_local_package\s*=\s*'([^']+)'", vtext)
        locale = loc.group(1) if loc else 'en_US'
        branch = '.'.join(version.split('.')[:2])
        row = next((r for r in rows if str(r.get('cycle')) == branch), None)
        if rows and row:
            latest = row.get('latest')
            if latest and vlt(version, latest):
                ctx.add('warning', 'wordpress', 'core-' + root, 'WordPress %s at %s is behind %s (same branch; these releases carry security fixes).' % (
                    version, root, latest), fix='Update WordPress in wp-admin > Dashboard > Updates, or `wp core update --minor`.')
            eol = parse_date(row.get('eol'))
            if eol is True or (isinstance(eol, datetime.date) and eol < t):
                ctx.add('warning', 'wordpress', 'core-eol-' + root, 'WordPress %s at %s: branch %s no longer gets security fixes.' % (
                    version, root, branch), fix='Update to the current WordPress (%s).' % rows[0].get('latest'))
            elif not (latest and vlt(version, latest)):
                ctx.add('ok', 'wordpress', 'core-' + root, 'WordPress %s at %s is the latest of its branch.' % (version, root))
        elif rows:
            ctx.add('critical', 'wordpress', 'core-old-' + root, 'WordPress %s at %s is so old it is not in the support list.' % (version, root),
                    fix='Update WordPress to %s.' % rows[0].get('latest'))
        sums = ctx.fetch('wordpress.org', 'https://api.wordpress.org/core/checksums/1.0/?version=%s&locale=%s' % (
            urllib.parse.quote(version), urllib.parse.quote(locale)))
        checksums = (sums or {}).get('checksums')
        if not isinstance(checksums, dict) and locale != 'en_US':
            sums = ctx.fetch('wordpress.org', 'https://api.wordpress.org/core/checksums/1.0/?version=%s&locale=en_US' % urllib.parse.quote(version))
            checksums = (sums or {}).get('checksums')
        if isinstance(checksums, dict):
            changed = []
            for rel, md5 in checksums.items():
                if rel.startswith('wp-content/'):
                    continue
                full = os.path.join(root, rel)
                if os.path.isfile(full) and md5_file(full) != md5:
                    changed.append(rel)
            extra = []
            for sub in ('wp-admin', 'wp-includes'):
                for d, dirs, files in os.walk(os.path.join(root, sub)):
                    for f in files:
                        if re.search(r'\.(php\d?|phtml|phar|ico)$', f, re.I):
                            rel = os.path.relpath(os.path.join(d, f), root)
                            if rel not in checksums:
                                extra.append(rel)
            if changed or extra:
                ctx.add('critical', 'wordpress', 'integrity-' + root, 'WordPress core at %s does not match wordpress.org: %s changed, %s added.' % (
                    root, plural(len(changed), 'file'), plural(len(extra), 'file')),
                    'Changed: %s\nAdded: %s' % (listing(changed, 10) or '-', listing(extra, 10) or '-'),
                    'Changed or extra core files are a classic sign of a hacked site. Compare them, then reinstall core: `wp core download --force --skip-content --version=%s`.' % version,
                    ['wp-integrity'])
            else:
                ctx.add('ok', 'wordpress', 'integrity-' + root, 'WordPress core files at %s match wordpress.org.' % root)
        cfg = os.path.join(root, 'wp-config.php')
        if not os.path.exists(cfg):
            cfg = os.path.join(os.path.dirname(root), 'wp-config.php')
        try:
            if os.stat(cfg).st_mode & 0o004:
                ctx.add('warning', 'wordpress', 'config-perm-' + root, '%s can be read by every user on the server.' % cfg,
                        'It holds the database password and secret keys.', 'chmod 640 (owner + web server group) or 600.')
        except OSError:
            pass
        outdated, closed = [], []
        for slug, pv in wp_plugins(root):
            if plugin_budget <= 0:
                break
            plugin_budget -= 1
            info = ctx.fetch('wordpress.org', 'https://api.wordpress.org/plugins/info/1.0/%s.json' % urllib.parse.quote(slug))
            if not isinstance(info, dict):
                continue
            if info.get('closed') or info.get('error') == 'closed':
                closed.append((slug, info.get('reason') or 'unknown', info.get('closed_date') or ''))
            elif info.get('version') and pv and vlt(pv, info['version']):
                outdated.append('%s %s -> %s' % (slug, pv, info['version']))
        for slug, reason, when in closed:
            ctx.add('critical' if 'security' in reason else 'warning', 'wordpress', 'plugin-closed-%s-%s' % (root, slug),
                    'Plugin "%s" at %s was closed on wordpress.org%s (reason: %s).' % (slug, root, ' on %s' % when if when else '', reason),
                    'Closed plugins get no more fixes; closures for security issues mean a known flaw is unfixed.',
                    'Remove the plugin or replace it with a maintained one.')
        if outdated:
            ctx.add('info', 'wordpress', 'plugins-' + root, '%s at %s: %s with newer versions: %s.' % (
                'WordPress', root, plural(len(outdated), 'plugin'), listing(outdated, 6)),
                fix='Update them in wp-admin > Plugins (many updates are security fixes), or `wp plugin update --all`.')


